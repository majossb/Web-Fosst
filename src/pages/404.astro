---
/**
 * Página 404 personalizada de FOSST
 */
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Página no encontrada (404) | FOSST"
  description="La página que buscas no existe o ha sido movida."
>
  <div class="page-container">
    <div class="container not-found-box scroll-reveal">
      <span class="code-badge">Error 404</span>
      <h1>Página no encontrada</h1>
      <p class="desc">
        La ruta que intentas visitar no existe o fue trasladada a otra sección de nuestro portal.
      </p>
      <div class="actions">
        <a href="/" class="btn-primary">
          Volver a la página principal
        </a>
        <a href="/diagnostico" class="btn-secondary btn-dark">
          Ir al diagnóstico empresarial
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-container {
    background-color: var(--blanco-calido);
    min-height: 80vh;
    padding-top: calc(var(--spacing-800) + 4rem);
    padding-bottom: var(--spacing-900);
    display: flex;
    align-items: center;
  }

  .not-found-box {
    text-align: center;
    max-width: 580px;
    margin: 0 auto;
  }

  .code-badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--azul-medio);
    background: var(--gris-claro);
    padding: var(--spacing-50) var(--spacing-100);
    border-radius: var(--radius-sm);
    margin-bottom: var(--spacing-200);
  }

  h1 {
    font-size: var(--text-4xl);
    color: var(--azul-marino);
    margin-bottom: var(--spacing-200);
  }

  .desc {
    font-size: var(--text-base);
    color: var(--gris-oscuro);
    margin: 0 auto var(--spacing-500);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-200);
  }

  .btn-dark {
    background: var(--azul-marino);
    color: #ffffff;
    border: none;
  }
</style>
