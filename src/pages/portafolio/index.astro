---
/**
 * Portafolio de Casos FOSST — Vista general
 */
import Layout from '../../layouts/Layout.astro';
import { CASOS } from '../../data/casos.js';
---

<Layout
  title="Portafolio de Casos y Proyectos | FOSST Consultoría Integral"
  description="Conoce casos reales y proyectos de implementación en SST, seguridad vial y riesgo psicosocial desarrollados por FOSST para mipymes."
>
  <div class="page-container">
    <div class="container">
      <header class="page-header scroll-reveal">
        <span class="badge-tag">Casos de intervención</span>
        <h1>Experiencia demostrada en mipymes colombianas</h1>
        <p class="subtitle">
          Casos reales de intervención donde transformamos el desorden y la incertidumbre legal en orden, prevención y tranquilidad operativa.
        </p>
      </header>

      <div class="cases-list">
        {CASOS.map((c) => (
          <article class="case-card scroll-reveal">
            <div class="case-meta">
              <span class="case-sector">{c.sector}</span>
              <span class="case-service">{c.servicio}</span>
            </div>
            <h2>{c.titulo}</h2>
            <p class="case-client"><strong>Organización:</strong> {c.cliente}</p>
            
            <div class="case-details">
              <div class="detail-item">
                <span class="label">Situación inicial:</span>
                <p>{c.problema}</p>
              </div>
              <div class="detail-item">
                <span class="label">Intervención FOSST:</span>
                <p>{c.solucion}</p>
              </div>
              <div class="detail-item result">
                <span class="label">Resultado comprobable:</span>
                <p>{c.resultado}</p>
              </div>
            </div>

            <div class="case-footer">
              <a href={`/portafolio/${c.slug}`} class="btn-outline-dark">
                Ver detalle del caso →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-container {
    background-color: var(--blanco-calido);
    min-height: 100vh;
    padding-top: calc(var(--spacing-800) + 2rem);
    padding-bottom: var(--spacing-900);
  }

  .page-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto var(--spacing-700);
  }

  .badge-tag {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--azul-medio);
    margin-bottom: var(--spacing-100);
  }

  .page-header h1 {
    font-size: var(--text-4xl);
    line-height: var(--lh-4xl);
    color: var(--azul-marino);
    margin-bottom: var(--spacing-200);
  }

  .page-header .subtitle {
    font-size: var(--text-base);
    color: var(--gris-oscuro);
  }

  .cases-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-500);
    max-width: 860px;
    margin: 0 auto;
  }

  .case-card {
    background: #ffffff;
    border: 1px solid var(--gris-borde);
    border-radius: var(--radius-lg);
    padding: var(--spacing-500);
    box-shadow: var(--shadow-sm);
  }

  .case-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-100);
    margin-bottom: var(--spacing-100);
  }

  .case-sector {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--azul-medio);
    background: var(--gris-claro);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .case-service {
    font-size: var(--text-xs);
    color: var(--gris-apagado);
    padding: 2px 8px;
  }

  .case-card h2 {
    font-size: var(--text-2xl);
    line-height: var(--lh-2xl);
    color: var(--azul-marino);
    margin-bottom: var(--spacing-100);
  }

  .case-client {
    font-size: var(--text-sm);
    color: var(--gris-apagado);
    margin-bottom: var(--spacing-300);
  }

  .case-details {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-200);
    margin-bottom: var(--spacing-400);
  }

  .detail-item .label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--gris-apagado);
    display: block;
    margin-bottom: 2px;
  }

  .detail-item p {
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    color: var(--gris-oscuro);
  }

  .detail-item.result {
    background: rgba(31, 79, 163, 0.06);
    border-left: 3px solid var(--azul-medio);
    padding: var(--spacing-100) var(--spacing-200);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .detail-item.result p {
    font-weight: 600;
    color: var(--azul-marino);
  }

  .case-footer {
    display: flex;
    justify-content: flex-end;
  }
</style>
