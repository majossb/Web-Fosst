---
/**
 * Página individual de caso de portafolio — getStaticPaths
 */
import Layout from '../../layouts/Layout.astro';
import { CASOS } from '../../data/casos.js';

export function getStaticPaths() {
  return CASOS.map((caso) => ({
    params: { slug: caso.slug },
    props: { caso },
  }));
}

const { caso } = Astro.props;
---

<Layout
  title={`${caso.titulo} | Casos FOSST`}
  description={`Caso de estudio: ${caso.problema}`}
>
  <div class="case-detail-wrapper">
    <div class="container">
      
      <nav class="breadcrumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>
        <span>/</span>
        <a href="/portafolio">Portafolio</a>
        <span>/</span>
        <span aria-current="page">{caso.titulo}</span>
      </nav>

      <header class="case-header scroll-reveal">
        <div class="case-tags">
          <span class="sector-tag">{caso.sector}</span>
          <span class="service-tag">{caso.servicio}</span>
        </div>
        <h1>{caso.titulo}</h1>
        <p class="case-org"><strong>Cliente / Organización:</strong> {caso.cliente}</p>
      </header>

      <div class="case-body-grid">
        <div class="case-narrative">
          
          <section class="narrative-block scroll-reveal">
            <h2>El problema inicial</h2>
            <p>{caso.problema}</p>
          </section>

          <section class="narrative-block scroll-reveal">
            <h2>La intervención técnica de FOSST</h2>
            <p>{caso.solucion}</p>
          </section>

          <section class="narrative-block result-block scroll-reveal">
            <h2>El resultado comprobable</h2>
            <p>{caso.resultado}</p>
          </section>

        </div>

        <aside class="case-sidebar scroll-reveal">
          <div class="sidebar-box">
            <h3>¿Tu empresa enfrenta una situación similar?</h3>
            <p>
              Inicia con un diagnóstico guiado para dimensionar el nivel de intervención requerido según tu sector y normatividad vigente.
            </p>
            <a href="/diagnostico" class="btn-primary w-full">
              Hacer mi diagnóstico
            </a>
            <a href="/agendar" class="btn-outline-dark w-full mt-2">
              Agendar asesoría
            </a>
          </div>
        </aside>
      </div>

    </div>
  </div>
</Layout>

<style>
  .case-detail-wrapper {
    background-color: var(--blanco-calido);
    min-height: 100vh;
    padding-top: calc(var(--spacing-800) + 2rem);
    padding-bottom: var(--spacing-900);
  }

  .breadcrumb {
    font-size: var(--text-xs);
    color: var(--gris-apagado);
    display: flex;
    gap: var(--spacing-75);
    margin-bottom: var(--spacing-400);
  }

  .breadcrumb a {
    color: var(--azul-medio);
  }

  .case-header {
    max-width: 800px;
    margin-bottom: var(--spacing-600);
  }

  .case-tags {
    display: flex;
    gap: var(--spacing-100);
    margin-bottom: var(--spacing-100);
  }

  .sector-tag {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--azul-medio);
    background: var(--gris-claro);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .service-tag {
    font-size: var(--text-xs);
    color: var(--gris-apagado);
    padding: 2px 8px;
  }

  .case-header h1 {
    font-size: var(--text-4xl);
    line-height: var(--lh-4xl);
    color: var(--azul-marino);
    margin-bottom: var(--spacing-100);
  }

  .case-org {
    font-size: var(--text-sm);
    color: var(--gris-apagado);
  }

  .case-body-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-600);
  }

  @media (min-width: 900px) {
    .case-body-grid {
      grid-template-columns: 2fr 1fr;
    }
  }

  .narrative-block {
    margin-bottom: var(--spacing-500);
    padding-bottom: var(--spacing-400);
    border-bottom: 1px solid var(--gris-borde);
  }

  .narrative-block h2 {
    font-size: var(--text-2xl);
    color: var(--azul-marino);
    margin-bottom: var(--spacing-200);
  }

  .narrative-block p {
    font-size: var(--text-base);
    line-height: var(--lh-base);
    color: var(--gris-oscuro);
  }

  .result-block {
    background: rgba(31, 79, 163, 0.05);
    border: 1px solid rgba(31, 79, 163, 0.2);
    border-radius: var(--radius-md);
    padding: var(--spacing-400);
  }

  .result-block h2 {
    color: var(--azul-medio);
  }

  .result-block p {
    font-weight: 600;
  }

  .sidebar-box {
    background: #ffffff;
    border: 1px solid var(--gris-borde);
    border-radius: var(--radius-lg);
    padding: var(--spacing-400);
    box-shadow: var(--shadow-sm);
    position: sticky;
    top: 100px;
  }

  .sidebar-box h3 {
    font-size: var(--text-lg);
    color: var(--azul-marino);
    margin-bottom: var(--spacing-200);
  }

  .sidebar-box p {
    font-size: var(--text-sm);
    color: var(--gris-oscuro);
    margin-bottom: var(--spacing-300);
  }

  .w-full {
    width: 100%;
    justify-content: center;
  }

  .mt-2 {
    margin-top: var(--spacing-100);
  }
</style>
