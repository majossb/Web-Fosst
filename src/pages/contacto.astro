---
/**
 * Página Contacto — Canales directos, formulario y redes
 */
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contacto | FOSST Consultoría Integral"
  description="Contáctanos a través de WhatsApp, correo electrónico o formulario para consultar servicios de consultoría en riesgos laborales en Colombia."
>
  <div class="page-container">
    <div class="container">
      
      <header class="page-header scroll-reveal">
        <span class="badge-tag">Canales de atención</span>
        <h1>Hablemos sobre las necesidades de tu empresa</h1>
        <p class="subtitle">
          Escríbenos por WhatsApp para una respuesta rápida o envíanos un mensaje con los detalles de tu consulta.
        </p>
      </header>

      <div class="contact-grid">
        
        <!-- Tarjeta de canales directos -->
        <div class="direct-channels-card scroll-reveal">
          <h2>Canales directos</h2>
          
          <div class="channel-item">
            <span class="channel-label">WhatsApp de atención prioritaria:</span>
            <a href="https://wa.me/573203865953" target="_blank" rel="noopener noreferrer" class="channel-link highlight">
              +57 320 386 5953
            </a>
          </div>

          <div class="channel-item">
            <span class="channel-label">WhatsApp de asesoría secundaria:</span>
            <a href="https://wa.me/573212262144" target="_blank" rel="noopener noreferrer" class="channel-link highlight">
              +57 321 226 2144
            </a>
          </div>

          <div class="channel-item">
            <span class="channel-label">Correo electrónico:</span>
            <a href="mailto:andreacortes.fosst@gmail.com" class="channel-link">
              andreacortes.fosst@gmail.com
            </a>
            <span class="note-pending">(Marcador temporal pendiente de correo corporativo)</span>
          </div>

          <div class="channel-item">
            <span class="channel-label">Redes sociales oficiales:</span>
            <div class="social-links">
              <a href="https://instagram.com/Fosst_oficial" target="_blank" rel="noopener noreferrer">Instagram: @Fosst_oficial</a>
              <a href="https://facebook.com" target="_blank" rel="noopener noreferrer">Facebook: Fosst</a>
            </div>
          </div>

          <div class="channel-item">
            <span class="channel-label">Cobertura geográfica:</span>
            <p class="geo-text">Atención presencial en Bogotá y Sabana de Bogotá. Asesoría, diseño y auditoría virtual en todo el territorio colombiano.</p>
          </div>
        </div>

        <!-- Formulario de contacto -->
        <div class="contact-form-card scroll-reveal">
          <h2>Envíanos un mensaje</h2>
          
          <form class="contact-form" onsubmit="event.preventDefault(); alert('¡Gracias por tu mensaje! El equipo de FOSST se pondrá en contacto pronto.');">
            <div class="form-group">
              <label for="contact-nombre">Nombre completo</label>
              <input type="text" id="contact-nombre" required placeholder="Tu nombre y apellido" class="form-control" />
            </div>

            <div class="form-group">
              <label for="contact-empresa">Empresa</label>
              <input type="text" id="contact-empresa" required placeholder="Nombre de tu empresa" class="form-control" />
            </div>

            <div class="form-group">
              <label for="contact-email">Correo electrónico</label>
              <input type="email" id="contact-email" required placeholder="tu@empresa.com" class="form-control" />
            </div>

            <div class="form-group">
              <label for="contact-celular">Celular / WhatsApp</label>
              <input type="tel" id="contact-celular" required placeholder="300 000 0000" class="form-control" />
            </div>

            <div class="form-group">
              <label for="contact-mensaje">¿En qué podemos ayudarte?</label>
              <textarea id="contact-mensaje" rows="4" required placeholder="Cuéntanos brevemente tu necesidad o si tienes una urgencia normativa..." class="form-control"></textarea>
            </div>

            <div class="consent-box">
              <label class="consent-label">
                <input type="checkbox" required />
                <span>Acepto la <a href="/legal/privacidad">Política de Tratamiento de Datos</a> de FOSST.</span>
              </label>
            </div>

            <button type="submit" class="btn-primary w-full">
              Enviar mensaje
            </button>
          </form>
        </div>

      </div>

    </div>
  </div>
</Layout>

<style>
  .page-container {
    background-color: var(--blanco-calido);
    min-height: 100vh;
    padding-top: calc(var(--spacing-800) + 2rem);
    padding-bottom: var(--spacing-900);
  }

  .page-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto var(--spacing-700);
  }

  .badge-tag {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--azul-medio);
    margin-bottom: var(--spacing-100);
  }

  .page-header h1 {
    font-size: var(--text-4xl);
    line-height: var(--lh-4xl);
    color: var(--azul-marino);
    margin-bottom: var(--spacing-200);
  }

  .page-header .subtitle {
    font-size: var(--text-base);
    color: var(--gris-oscuro);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-500);
    max-width: 960px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .direct-channels-card,
  .contact-form-card {
    background: #ffffff;
    border: 1px solid var(--gris-borde);
    border-radius: var(--radius-xl);
    padding: var(--spacing-500);
    box-shadow: var(--shadow-sm);
  }

  .direct-channels-card h2,
  .contact-form-card h2 {
    font-size: var(--text-2xl);
    color: var(--azul-marino);
    margin-bottom: var(--spacing-400);
  }

  .channel-item {
    margin-bottom: var(--spacing-300);
    padding-bottom: var(--spacing-200);
    border-bottom: 1px solid var(--gris-claro);
  }

  .channel-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--gris-apagado);
    margin-bottom: 2px;
  }

  .channel-link {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--azul-marino);
  }

  .channel-link.highlight {
    color: var(--azul-medio);
    font-weight: 700;
  }

  .note-pending {
    display: block;
    font-size: 11px;
    color: var(--gris-apagado);
    margin-top: 2px;
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 4px;
  }

  .social-links a {
    font-size: var(--text-sm);
    color: var(--azul-medio);
  }

  .geo-text {
    font-size: var(--text-sm);
    color: var(--gris-oscuro);
    margin-top: 4px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-200);
  }

  .form-group label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--azul-marino);
    margin-bottom: 4px;
  }

  .form-control {
    width: 100%;
    padding: var(--spacing-100);
    border: 1px solid var(--gris-borde);
    border-radius: var(--radius-md);
    font-family: inherit;
    font-size: var(--text-sm);
    color: var(--gris-oscuro);
  }

  .consent-box {
    margin: var(--spacing-100) 0;
  }

  .consent-label {
    font-size: var(--text-xs);
    color: var(--gris-apagado);
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-75);
    cursor: pointer;
  }

  .consent-label a {
    color: var(--azul-medio);
  }

  .w-full {
    width: 100%;
    justify-content: center;
  }
</style>
