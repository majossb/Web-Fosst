---
/**
 * Página Clientes y Opiniones — Respeto a datos reales y verificados
 */
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Clientes y Opiniones Verificadas | FOSST"
  description="Opiniones y sectores que confían en FOSST para su gestión de riesgos laborales, SG-SST y seguridad vial."
>
  <div class="page-container">
    <div class="container">
      
      <header class="page-header scroll-reveal">
        <span class="badge-tag">Confianza comprobable</span>
        <h1>Clientes y testimonios verificados</h1>
        <p class="subtitle">
          En FOSST nos regimos por la transparencia: solo publicamos testimonios y logotipos debidamente autorizados por nuestros clientes.
        </p>
      </header>

      <!-- Sectores atendidos -->
      <section class="sectors-section scroll-reveal">
        <h2>Sectores empresariales donde intervenimos</h2>
        <div class="sectors-grid">
          <div class="sector-card">
            <h3>Industria y Manufactura</h3>
            <p>Empresas metalmecánicas, plásticos, confección y talleres de mantenimiento.</p>
          </div>
          <div class="sector-card">
            <h3>Transporte y Logística</h3>
            <p>Empresas de mensajería urbana, distribución de mercancías y flotas de carga.</p>
          </div>
          <div class="sector-card">
            <h3>Servicios y Tecnología</h3>
            <p>Empresas de software, consultoría, BPO y oficinas administrativas.</p>
          </div>
          <div class="sector-card">
            <h3>Comercio y Alimentos</h3>
            <p>Restaurantes, distribución de víveres y cadenas de comercialización al por menor.</p>
          </div>
        </div>
      </section>

      <!-- Política de reseñas verificadas -->
      <section class="reviews-policy-section scroll-reveal">
        <div class="policy-card">
          <h3>Nuestra política de opiniones verificadas</h3>
          <p>
            Al finalizar cada proceso de consultoría, enviamos a la gerencia un enlace único e intransferible para calificar la calidad, oportunidad y rigor de nuestro servicio.
          </p>
          <p class="policy-note">
            No editamos comentarios ni inventamos calificaciones en estrellas. Las opiniones se publican únicamente con autorización expresa de la organización.
          </p>
          <div class="policy-action">
            <a href="/diagnostico" class="btn-primary">
              Comenzar con un diagnóstico
            </a>
          </div>
        </div>
      </section>

    </div>
  </div>
</Layout>

<style>
  .page-container {
    background-color: var(--blanco-calido);
    min-height: 100vh;
    padding-top: calc(var(--spacing-800) + 2rem);
    padding-bottom: var(--spacing-900);
  }

  .page-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto var(--spacing-800);
  }

  .badge-tag {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--azul-medio);
    margin-bottom: var(--spacing-100);
  }

  .page-header h1 {
    font-size: var(--text-4xl);
    line-height: var(--lh-4xl);
    color: var(--azul-marino);
    margin-bottom: var(--spacing-200);
  }

  .page-header .subtitle {
    font-size: var(--text-base);
    color: var(--gris-oscuro);
  }

  .sectors-section {
    margin-bottom: var(--spacing-800);
  }

  .sectors-section h2 {
    font-size: var(--text-3xl);
    color: var(--azul-marino);
    margin-bottom: var(--spacing-400);
    text-align: center;
  }

  .sectors-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-300);
  }

  @media (min-width: 600px) {
    .sectors-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .sectors-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .sector-card {
    background: #ffffff;
    border: 1px solid var(--gris-borde);
    border-radius: var(--radius-md);
    padding: var(--spacing-300);
  }

  .sector-card h3 {
    font-size: var(--text-base);
    color: var(--azul-marino);
    margin-bottom: var(--spacing-100);
  }

  .sector-card p {
    font-size: var(--text-xs);
    color: var(--gris-oscuro);
  }

  .reviews-policy-section {
    max-width: 720px;
    margin: 0 auto;
  }

  .policy-card {
    background: var(--gris-claro);
    border: 1px solid var(--gris-borde);
    border-radius: var(--radius-xl);
    padding: var(--spacing-600);
    text-align: center;
  }

  .policy-card h3 {
    font-size: var(--text-2xl);
    color: var(--azul-marino);
    margin-bottom: var(--spacing-200);
  }

  .policy-card p {
    font-size: var(--text-sm);
    color: var(--gris-oscuro);
    margin: 0 auto var(--spacing-200);
  }

  .policy-note {
    font-weight: 600;
    color: var(--azul-marino) !important;
  }

  .policy-action {
    margin-top: var(--spacing-400);
  }
</style>
