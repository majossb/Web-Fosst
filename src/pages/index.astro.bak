---
// src/pages/index.astro
// FOSST Consultoría Integral — Página Principal Corporativa
// Continuidad visual fluida, contenido honesto y arquitectura orientada a conversión
import Hero from '../components/Hero.astro';
import NarrativeTransition from '../components/NarrativeTransition.astro';
import ServicesShowcase from '../components/ServicesShowcase.astro';
import MethodologySection from '../components/MethodologySection.astro';
import CasesPreview from '../components/CasesPreview.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/assets/logo-fosst-icon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <title>FOSST Consultoría Integral | Seguridad y Salud en el Trabajo para Mipymes en Colombia</title>
    <meta 
      name="description" 
      content="Acompañamos a las empresas colombianas en la gestión integral de riesgos laborales, diseño e implementación del SG-SST, planes de seguridad vial (PESV), riesgo psicosocial y asesoría jurídica laboral." 
    />
    <meta name="theme-color" content="#001A4D" />

    <!-- Google Fonts: Editorial Serif (Playfair Display) & Modern Sans (Plus Jakarta Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" 
      rel="stylesheet" 
    />
  </head>
  <body>
    <!-- Enlace accesible de salto al contenido -->
    <a href="#inicio" class="skip-link">Saltar al contenido principal</a>

    <!-- 1. Hero Fotográfico Interactivo Protagonista -->
    <Hero />

    <main id="main-content">
      <!-- 2. Transición Narrativa: Del riesgo en el terreno a la tranquilidad operativa -->
      <NarrativeTransition />

      <!-- 3. Presentación Visual y Resumida de los 9 Servicios Oficiales -->
      <ServicesShowcase />

      <!-- 4. Metodología de Acompañamiento Técnico en 3 Fases Reales -->
      <MethodologySection />

      <!-- 5. Casos Reales y Autorizados de Intervención -->
      <CasesPreview />

      <!-- 6. Cierre con Llamadas a la Acción Directas (Diagnóstico, WhatsApp y Contacto) -->
      <CtaBanner />
    </main>

    <!-- 7. Footer Corporativo con Datos Verificables y Enlaces Legales -->
    <Footer />

    <!-- 8. Botón Flotante Accesible de WhatsApp -->
    <WhatsAppFab />
  </body>
</html>

<style is:global>
  /* ════════════════════════════════════════
     DESIGN TOKENS & RESET GLOBAL FOSST
     ════════════════════════════════════════ */
  :root {
    --navy: #001A4D;
    --navy-dark: #001133;
    --navy-deep: #000F2E;
    --yellow: #FFC800;
    --yellow-hover: #ffd01a;
    --white: #F7F7F2;
    --text-muted: rgba(247, 247, 242, 0.75);
    --border-subtle: rgba(255, 255, 255, 0.1);
    --font-serif: 'Playfair Display', Georgia, serif;
    --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    width: 100%;
    min-height: 100%;
    background-color: var(--navy-deep);
    color: var(--white);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
  }

  /* Desplazamiento suave para anclas */
  html {
    scroll-behavior: smooth;
  }

  /* Selección de texto con identidad de marca */
  ::selection {
    background-color: var(--yellow);
    color: var(--navy);
  }

  /* Enlace accesible de salto */
  .skip-link {
    position: absolute;
    top: -100px;
    left: 1rem;
    background: var(--yellow);
    color: var(--navy);
    padding: 0.6rem 1.2rem;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 4px;
    z-index: 10000;
    text-decoration: none;
    transition: top 0.2s ease;
  }
  .skip-link:focus {
    top: 1rem;
  }

  /* Respeto estricto a preferencias de movimiento reducido */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
