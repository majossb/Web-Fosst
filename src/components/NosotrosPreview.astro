---
// src/components/NosotrosPreview.astro
// FOSST Consultoría Integral — Sección "Nosotros" del Landing Page
// Rediseño editorial y abanico interactivo de atributos diferenciales
import usersThree from '../assets/icons/users-three-duotone.svg?raw';
import scales from '../assets/icons/scales-duotone.svg?raw';
import handshake from '../assets/icons/handshake-duotone.svg?raw';
import heart from '../assets/icons/heart-duotone.svg?raw';

const caracteristicas = [
  {
    id: 'equipo',
    titulo: 'Equipo multidisciplinario',
    frenteDesc: 'Expertos en SST, gestión empresarial y más.',
    reversoTexto: 'Profesionales de diferentes áreas que integran conocimientos para ofrecer un acompañamiento completo a las organizaciones.',
    iconSvg: usersThree,
    hasSpark: true,
    rot: -8,
    dy: 18,
  },
  {
    id: 'cumplimiento',
    titulo: 'Cumplimiento normativo',
    frenteDesc: 'Te guiamos para cumplir con la normativa vigente.',
    reversoTexto: 'Orientación técnica para ayudar a las empresas a cumplir sus obligaciones legales y normativas.',
    iconSvg: scales,
    hasSpark: false,
    rot: -5,
    dy: 6,
  },
  {
    id: 'soluciones',
    titulo: 'Soluciones a la medida de mipymes',
    frenteDesc: 'Estrategias efectivas para tu empresa.',
    reversoTexto: 'Acompañamiento y estrategias adaptadas a las necesidades y posibilidades de cada empresa.',
    iconSvg: handshake,
    hasSpark: false,
    rot: -1,
    dy: -4,
  },
  {
    id: 'cercania',
    titulo: 'Cercanía humana',
    frenteDesc: 'Estamos contigo en cada paso.',
    reversoTexto: 'Un acompañamiento cercano, en el que escuchamos, comprendemos y trabajamos junto a nuestros clientes.',
    iconSvg: heart,
    hasSpark: true,
    rot: 5,
    dy: 12,
  },
];
---

<section class="nos-section" id="nosotros" aria-labelledby="nos-title">
  <!-- Borde superior arquitectónico con halo sutil (interfaz de unión con el Hero) -->
  <div class="nos-horizon-lip" aria-hidden="true"></div>

  <!-- Textura sutil de puntos decorativos en el margen izquierdo -->
  <div class="nos-dot-matrix-left" aria-hidden="true">
    {Array.from({ length: 24 }).map(() => <span class="matrix-dot"></span>)}
  </div>

  <!-- Línea orgánica gestual en la esquina inferior izquierda -->
  <div class="nos-bottom-loop" aria-hidden="true">
    <svg width="220" height="110" viewBox="0 0 220 110" fill="none">
      <path d="M-20 85 C 40 85, 80 40, 50 20 C 20 0, 0 50, 45 75 C 90 100, 150 95, 215 110" stroke="#FFC800" stroke-width="3" stroke-linecap="round"/>
    </svg>
  </div>

  <div class="nos-layout-grid">
    
    <!-- ════════════════════════════════════════════════════════════════
         LADO IZQUIERDO: PRESENTACIÓN EDITORIAL FOSST
         ════════════════════════════════════════════════════════════════ -->
    <div class="nos-editorial-side">
      
      <!-- Encabezado / Kicker -->
      <div class="nos-kicker-bar reveal-node" data-reveal-delay="0">
        <span class="kicker-amber-dot" aria-hidden="true"></span>
        <span class="kicker-brand">CONOCE FOSST</span>
        <span class="kicker-divider" aria-hidden="true"></span>
        <span class="kicker-tagline">CONSULTORÍA CON VISIÓN HUMANA</span>
      </div>

      <!-- Gran Titular Protagonista con Tipografía Serif Elegante -->
      <h2 class="nos-main-title" id="nos-title">
        <span class="title-line-mask">
          <span class="title-line-inner reveal-line" data-reveal-delay="80">
            El respaldo técnico
          </span>
        </span>
        <span class="title-line-mask">
          <span class="title-line-inner reveal-line" data-reveal-delay="180">
            de una gran consultora,
          </span>
        </span>
        <span class="title-line-mask">
          <span class="title-line-inner reveal-line" data-reveal-delay="280">
            con la <span class="cercania-accent-wrap">
              <em class="title-serif-italic">cercanía humana</em>
              <svg class="title-organic-swoosh" width="165" height="10" viewBox="0 0 165 10" fill="none" aria-hidden="true">
                <path d="M2 7C45 2.5 105 8 163 3.5" stroke="#FFC800" stroke-width="3.2" stroke-linecap="round"/>
              </svg>
            </span>
          </span>
        </span>
        <span class="title-line-mask">
          <span class="title-line-inner reveal-line" data-reveal-delay="380">
            de un aliado.
          </span>
        </span>
      </h2>

      <!-- Descripción Breve y Asertiva -->
      <p class="nos-brief-lead reveal-node" data-reveal-delay="460">
        Acompañamos a las organizaciones a comprender sus riesgos, fortalecer su gestión y construir entornos de trabajo más seguros.
      </p>

      <!-- Enlace Editorial a Conocer la Historia Completa -->
      <div class="nos-link-wrap reveal-node" data-reveal-delay="540">
        <a href="/nosotros" class="nos-story-link" id="nos-history-btn">
          <span>Descubre quiénes somos</span>
          <svg class="link-diagonal-arrow" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>

    </div>

    <!-- ════════════════════════════════════════════════════════════════
         LADO DERECHO: ESCENARIO INTERACTIVO (TARJETAS EN ABANICO)
         ════════════════════════════════════════════════════════════════ -->
    <div class="nos-interactive-stage">
      
      <!-- Placeholder de cabecera (preparada para las capas de Mascota en Etapa 2) -->
      <div class="mascot-stage-anchor reveal-node" data-reveal-delay="200">
        <!-- Espacio reservado para la mascota asomada -->
      </div>

      <!-- Abanico de 4 Tarjetas Interactivas con Volteo 3D Accesible -->
      <ul 
        class="cards-fan" 
        role="region" 
        aria-label="Los cuatro aspectos diferenciales que definen a FOSST"
      >
        {caracteristicas.map((item, idx) => (
          <li 
            class="flip-card-slot reveal-node" 
            data-reveal-delay={300 + idx * 80}
          >
            <div 
              class="flip-card" 
              data-flipped="false"
              data-card-id={item.id}
              style={`--rot: ${item.rot}deg; --dy: ${item.dy}px;`}
            >
              <div class="flip-inner">
                
                <!-- ── CARA FRONTAL ── -->
                <div class="face front" id={`front-${item.id}`}>
                  <div class="card-icon-wrap">
                    <span class="card-icon" aria-hidden="true" set:html={item.iconSvg} />
                    {item.hasSpark && (
                      <svg class="icon-sparkle" width="22" height="22" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <line x1="10" y1="2" x2="10" y2="6" stroke="#FFC800" stroke-width="2.2" stroke-linecap="round" />
                        <line x1="16" y1="4" x2="13" y2="7" stroke="#FFC800" stroke-width="2.2" stroke-linecap="round" />
                        <line x1="18" y1="10" x2="14" y2="10" stroke="#FFC800" stroke-width="2.2" stroke-linecap="round" />
                      </svg>
                    )}
                  </div>
                  <h3 class="card-front-title">{item.titulo}</h3>
                  <p class="card-front-summary">{item.frenteDesc}</p>
                  
                  <div class="card-bottom-accent" aria-hidden="true">
                    <span class="touch-hint">Toca para ver más</span>
                    <span class="accent-line"></span>
                  </div>
                </div>

                <!-- ── CARA POSTERIOR (REVERSO LIMPIO Y ESTRUCTURADO) ── -->
                <div class="face back" id={`back-${item.id}`} aria-hidden="true" inert>
                  <span class="back-star" aria-hidden="true">✦</span>
                  <h3 class="card-back-title">{item.titulo}</h3>
                  <span class="back-divider" aria-hidden="true"></span>
                  <p class="back-desc">{item.reversoTexto}</p>
                </div>

              </div>

              <!-- Botón de volteo accesible que cubre la tarjeta -->
              <button 
                type="button" 
                class="flip-toggle" 
                aria-expanded="false" 
                aria-controls={`back-${item.id}`}
              >
                <span class="sr-only">Ver descripción de {item.titulo}</span>
              </button>
            </div>
          </li>
        ))}
      </ul>

    </div>

  </div>

  <!-- Borde de transición inferior hacia Servicios (sección azul oscuro) -->
  <div class="nos-transition-bottom" aria-hidden="true">
    <div class="transition-lip-curve"></div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════════════════
     ESTILOS CSS — EDITORIAL, ABANICO DE TARJETAS Y VOLTEO 3D
     ════════════════════════════════════════════════════════════════ -->
<style>
  /* ── Variables de la Sección Editorial FOSST ── */
  .nos-section {
    --nos-canvas-bg: #FEF9F1;
    --nos-card-bg: #FBF7EF;
    --nos-card-back-bg: #FAF7F0;
    --nos-ink-navy: #001A4D;
    --nos-ink-body: #3A4256;
    --nos-ink-muted: #6C7589;
    --nos-gold-safety: #FFC800;
    --nos-border-subtle: rgba(0, 26, 77, 0.06);
    --nos-serif: 'Instrument Serif', 'Playfair Display', Georgia, serif;

    position: relative;
    z-index: 6; /* Por encima del Hero fijo */
    margin-top: -100vh; /* Se superpone durante el recorrido de recogimiento del Hero */
    min-height: 100vh;
    background-color: var(--nos-canvas-bg);
    color: var(--nos-ink-body);
    border-radius: clamp(36px, 5.5vw, 64px) clamp(36px, 5.5vw, 64px) 0 0;
    box-shadow: 0 -32px 70px -20px rgba(0, 15, 46, 0.6);
    padding: clamp(5rem, 8.5vw, 8rem) clamp(1.25rem, 4vw, 3.5rem) 0;
    overflow: visible;
  }

  /* ── Halo arquitectónico superior ── */
  .nos-horizon-lip {
    position: absolute;
    top: 0;
    left: 8%;
    right: 8%;
    height: 2px;
    background: linear-gradient(90deg, 
      rgba(255, 200, 0, 0) 0%, 
      rgba(255, 200, 0, 0.5) 30%, 
      rgba(255, 200, 0, 0.95) 50%, 
      rgba(255, 200, 0, 0.5) 70%, 
      rgba(255, 200, 0, 0) 100%
    );
    border-radius: 2px;
    pointer-events: none;
    opacity: 0.9;
  }

  /* ── Matriz de puntos decorativa a la izquierda ── */
  .nos-dot-matrix-left {
    position: absolute;
    left: 1.5rem;
    top: 38%;
    display: grid;
    grid-template-columns: repeat(3, 6px);
    grid-gap: 12px;
    opacity: 0.35;
    pointer-events: none;
  }
  .matrix-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--nos-ink-navy);
  }

  /* ── Bucle orgánico amarillo inferior ── */
  .nos-bottom-loop {
    position: absolute;
    left: 0;
    bottom: 2rem;
    pointer-events: none;
    z-index: 1;
    opacity: 0.85;
  }

  /* ── Cuadrícula Principal de 2 Grandes Espacios ── */
  .nos-layout-grid {
    position: relative;
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 4.5vw, 4rem);
    align-items: center;
    padding-bottom: clamp(4.5rem, 7vw, 7.5rem);
    z-index: 2;
  }

  @media (min-width: 1180px) {
    .nos-layout-grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
      gap: 3.5rem;
    }
  }

  /* ════════════════════════════════════════════════════════════════
     LADO IZQUIERDO: ESTILO EDITORIAL
     ════════════════════════════════════════════════════════════════ */
  .nos-editorial-side {
    position: relative;
    z-index: 3;
    max-width: 540px;
  }

  /* Kicker / Encabezado superior */
  .nos-kicker-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.5rem;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .kicker-amber-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--nos-gold-safety);
    box-shadow: 0 0 8px rgba(255, 200, 0, 0.6);
  }
  .kicker-brand {
    color: var(--nos-ink-navy);
    font-weight: 800;
  }
  .kicker-divider {
    width: 24px;
    height: 2px;
    background: rgba(0, 26, 77, 0.25);
    border-radius: 1px;
  }
  .kicker-tagline {
    color: var(--nos-ink-navy);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  /* Gran Titular Editorial */
  .nos-main-title {
    margin: 0 0 1.75rem;
    font-family: var(--nos-serif);
    font-size: clamp(2.4rem, 4.5vw, 3.85rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--nos-ink-navy);
  }

  .title-line-mask {
    display: block;
    overflow: hidden;
  }

  .title-line-inner {
    display: inline-block;
    transform: translateY(110%);
    opacity: 0;
    transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.85s ease;
    will-change: transform, opacity;
  }

  .nos-section.is-revealed .title-line-inner {
    transform: translateY(0);
    opacity: 1;
  }

  .cercania-accent-wrap {
    position: relative;
    display: inline-block;
  }

  .title-serif-italic {
    font-family: var(--nos-serif);
    font-style: italic;
    font-weight: 400;
    color: #1F4FA3;
    position: relative;
  }

  .title-organic-swoosh {
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 8px;
    pointer-events: none;
    filter: drop-shadow(0 1px 2px rgba(255, 200, 0, 0.4));
  }

  /* Descripción Breve */
  .nos-brief-lead {
    margin: 0 0 2.25rem;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: clamp(1.02rem, 1.2vw, 1.15rem);
    line-height: 1.68;
    color: var(--nos-ink-body);
    max-width: 48ch;
  }

  /* Enlace con Línea Amarilla */
  .nos-link-wrap {
    display: inline-flex;
    align-items: center;
  }

  .nos-story-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--nos-ink-navy);
    text-decoration: none;
    padding-bottom: 0.35rem;
    border-bottom: 2.5px solid var(--nos-gold-safety);
    transition: color 0.2s, border-color 0.2s, transform 0.2s;
  }
  .nos-story-link:hover {
    color: #1F4FA3;
    border-color: #FFD21A;
    transform: translateX(3px);
  }
  .link-diagonal-arrow {
    transition: transform 0.25s ease;
  }
  .nos-story-link:hover .link-diagonal-arrow {
    transform: translate(2px, -2px);
  }

  /* ════════════════════════════════════════════════════════════════
     LADO DERECHO: ESCENARIO INTERACTIVO Y ABANICO DE TARJETAS
     ════════════════════════════════════════════════════════════════ */
  .nos-interactive-stage {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 3;
    isolation: isolate;
  }

  .mascot-stage-anchor {
    position: relative;
    width: 100%;
    max-width: 360px;
    height: 10px; /* Placeholder para Etapa 2 */
    margin: 0 auto;
    pointer-events: none;
  }

  /* ── Lista de Tarjetas en Abanico ── */
  .cards-fan {
    list-style: none;
    margin: 0;
    padding: 1.5rem 0 0.5rem;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    position: relative;
    z-index: 3;
  }

  /* ── Tarjeta individual en Abanico ── */
  .flip-card-slot {
    position: relative;
    margin-left: clamp(-16px, -1.2vw, -8px);
    perspective: 1100px;
  }
  .flip-card-slot:first-child {
    margin-left: 0;
  }

  .flip-card {
    position: relative;
    width: clamp(174px, 13.5vw, 205px);
    min-height: 290px;
    height: 290px;
    transform: translateY(var(--dy, 0px)) rotate(var(--rot, 0deg));
    transform-origin: center bottom;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), z-index 0.3s ease;
    will-change: transform;
    border-radius: 24px;
  }

  /* Al interactuar (hover, foco o flipped): se endereza y sube ~8-10px pasando sobre vecinas */
  @media (hover: hover) and (pointer: fine) {
    .flip-card:hover {
      transform: translateY(-8px) rotate(0deg);
      z-index: 10;
    }
  }

  .flip-card:focus-within,
  .flip-card[data-flipped="true"] {
    transform: translateY(-8px) rotate(0deg);
    z-index: 10;
  }

  /* ── Contenedor 3D Flip ── */
  .flip-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
    border-radius: 24px;
    box-shadow: 0 18px 36px -14px rgba(0, 26, 77, 0.18);
  }

  .flip-card:hover .flip-inner,
  .flip-card[data-flipped="true"] .flip-inner {
    box-shadow: 0 24px 44px -12px rgba(0, 26, 77, 0.24);
  }

  .flip-card[data-flipped="true"] .flip-inner {
    transform: rotateY(180deg);
  }

  /* ── Caras Frontal y Posterior ── */
  .face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 24px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Frente */
  .face.front {
    background: var(--nos-card-bg);
    border: 1px solid var(--nos-border-subtle);
    padding: 1.5rem 1.15rem 1.25rem;
    z-index: 2;
    transform: rotateY(0deg);
  }

  .card-icon-wrap {
    position: relative;
    width: 84px;
    height: 84px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.65rem;
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.card-icon svg) {
    width: 80px;
    height: 80px;
    color: #001A4D;
    display: block;
  }

  :global(.card-icon svg path[opacity]) {
    fill: #FFC800;
    opacity: 1 !important;
  }

  .flip-card:hover .card-icon,
  .flip-card[data-flipped="true"] .card-icon {
    transform: scale(1.06);
  }

  .icon-sparkle {
    position: absolute;
    top: -2px;
    right: -4px;
    pointer-events: none;
    animation: sparkPulse 3.5s ease-in-out infinite;
  }

  @keyframes sparkPulse {
    0%, 100% { opacity: 0.85; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.12); }
  }

  .card-front-title {
    margin: 0 0 0.45rem;
    font-family: var(--nos-serif);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--nos-ink-navy);
  }

  .card-front-summary {
    margin: 0 0 auto;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--nos-ink-body);
  }

  .card-bottom-accent {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 0.65rem;
  }

  .touch-hint {
    display: none;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.7rem;
    color: var(--nos-ink-muted);
    margin-bottom: 0.35rem;
    font-weight: 500;
  }

  @media (hover: none) {
    .touch-hint {
      display: block;
    }
  }

  .accent-line {
    width: 32px;
    height: 3px;
    background: var(--nos-gold-safety);
    border-radius: 2px;
  }

  /* Reverso */
  .face.back {
    background: var(--nos-card-back-bg);
    border: 1.5px solid rgba(0, 26, 77, 0.1);
    transform: rotateY(180deg);
    padding: 1.6rem 1.25rem 1.4rem;
    justify-content: center;
  }

  .back-star {
    font-size: 0.95rem;
    color: var(--nos-gold-safety);
    margin-bottom: 0.5rem;
    display: block;
    line-height: 1;
  }

  .card-back-title {
    margin: 0 0 0.5rem;
    font-family: var(--nos-serif);
    font-size: 1.15rem;
    font-weight: 400;
    line-height: 1.22;
    color: var(--nos-ink-navy);
  }

  .back-divider {
    width: 28px;
    height: 2.5px;
    background: var(--nos-gold-safety);
    border-radius: 2px;
    margin-bottom: 0.85rem;
    display: block;
  }

  .back-desc {
    margin: 0;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.86rem;
    line-height: 1.52;
    color: var(--nos-ink-body);
  }

  /* Botón interactivo invisible para accesibilidad y clics */
  .flip-toggle {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 5;
    background: transparent;
    border: none;
    cursor: pointer;
    border-radius: 24px;
    padding: 0;
    margin: 0;
  }

  .flip-toggle:focus-visible {
    outline: 3px solid var(--nos-gold-safety);
    outline-offset: 4px;
  }

  /* Utilidad sr-only */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ════════════════════════════════════════════════════════════════
     ANIMACIONES DE ENTRADA PROGRESIVA
     ════════════════════════════════════════════════════════════════ */
  .reveal-node {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .nos-section.is-revealed .reveal-node {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Transición inferior hacia Servicios ── */
  .nos-transition-bottom {
    position: relative;
    height: 52px;
    margin: 0 calc(-1 * clamp(1.25rem, 4vw, 3.5rem));
    background: #000F2E;
    border-radius: clamp(32px, 5vw, 56px) clamp(32px, 5vw, 56px) 0 0;
  }

  /* ════════════════════════════════════════════════════════════════
     RESPONSIVIDAD Y DISPOSITIVOS MÓVILES
     ════════════════════════════════════════════════════════════════ */
  /* Cuadrícula 2x2 entre 760px y 1179px */
  @media (max-width: 1179px) and (min-width: 760px) {
    .cards-fan {
      display: grid;
      grid-template-columns: repeat(2, minmax(220px, 270px));
      gap: 1.35rem;
      justify-content: center;
      padding-top: 1rem;
    }
    .flip-card-slot {
      margin-left: 0;
    }
    .flip-card {
      width: 100%;
      height: 290px;
      transform: none !important;
    }
    .flip-card:hover,
    .flip-card:focus-within,
    .flip-card[data-flipped="true"] {
      transform: translateY(-6px) !important;
      z-index: 5;
    }
  }

  /* Columna única en pantallas menores a 760px */
  @media (max-width: 759px) {
    .nos-section {
      margin-top: -90vh;
      border-radius: 28px 28px 0 0;
      padding-top: 4.5rem;
    }
    .cards-fan {
      display: grid;
      grid-template-columns: 1fr;
      max-width: 340px;
      margin: 0 auto;
      gap: 1.15rem;
      padding-top: 0.5rem;
    }
    .flip-card-slot {
      margin-left: 0;
    }
    .flip-card {
      width: 100%;
      height: 280px;
      transform: none !important;
    }
    .flip-card:hover,
    .flip-card:focus-within,
    .flip-card[data-flipped="true"] {
      transform: translateY(-4px) !important;
      z-index: 5;
    }
    .nos-editorial-side {
      text-align: left;
    }
    .nos-dot-matrix-left {
      display: none;
    }
  }

  /* ════════════════════════════════════════════════════════════════
     PREFERENCIAS DE MOVIMIENTO REDUCIDO
     ════════════════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .nos-section {
      margin-top: 0;
      box-shadow: none;
    }
    .reveal-node, .title-line-inner {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    .flip-card {
      transform: none !important;
      transition: none !important;
    }
    .flip-inner {
      transition: none !important;
      transform: none !important;
    }
    .flip-card[data-flipped="true"] .flip-inner {
      transform: none !important;
    }
    .face {
      transition: opacity 150ms ease !important;
    }
    .flip-card[data-flipped="false"] .face.front {
      opacity: 1;
      pointer-events: auto;
    }
    .flip-card[data-flipped="false"] .face.back {
      opacity: 0;
      pointer-events: none;
      transform: none !important;
    }
    .flip-card[data-flipped="true"] .face.front {
      opacity: 0;
      pointer-events: none;
      transform: none !important;
    }
    .flip-card[data-flipped="true"] .face.back {
      opacity: 1;
      pointer-events: auto;
      transform: none !important;
    }
  }
</style>

<noscript>
  <style>
    .reveal-node, .title-line-inner { opacity: 1 !important; transform: none !important; }
  </style>
</noscript>

<!-- ════════════════════════════════════════════════════════════════
     LÓGICA CLIENTE — ACCESIBILIDAD, VOLTEO FLIP Y GESTIÓN DE DISPOSITIVOS
     ════════════════════════════════════════════════════════════════ -->
<script>
  (() => {
    const nosSection = document.getElementById('nosotros');
    if (!nosSection) return;

    // 1. REVELADO PROGRESIVO DE LÍNEAS Y ELEMENTOS (INTERSECTION OBSERVER)
    const revealElements = () => {
      const revealNodes = nosSection.querySelectorAll<HTMLElement>('.reveal-node, .reveal-line');
      revealNodes.forEach((node) => {
        const delay = node.getAttribute('data-reveal-delay') || '0';
        node.style.transitionDelay = `${delay}ms`;
      });
      nosSection.classList.add('is-revealed');
    };

    if (!('IntersectionObserver' in window)) {
      revealElements();
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          const entry = entries[0];
          if (entry.isIntersecting) {
            revealElements();
          }
        },
        { threshold: 0.12 }
      );
      observer.observe(nosSection);
    }

    // 2. INTERACCIÓN DE VOLTEO 3D ACCESIBLE (MOUSE, TÁCTIL Y TECLADO)
    const cards = Array.from(nosSection.querySelectorAll<HTMLElement>('.flip-card'));
    let lastPointerType = '';

    const setCardFlipped = (card: HTMLElement, shouldFlip: boolean) => {
      card.dataset.flipped = String(shouldFlip);
      const button = card.querySelector<HTMLButtonElement>('.flip-toggle');
      if (button) {
        button.setAttribute('aria-expanded', String(shouldFlip));
      }
      const front = card.querySelector<HTMLElement>('.face.front');
      const back = card.querySelector<HTMLElement>('.face.back');
      if (front && back) {
        if (shouldFlip) {
          front.setAttribute('aria-hidden', 'true');
          front.setAttribute('inert', '');
          back.removeAttribute('aria-hidden');
          back.removeAttribute('inert');
        } else {
          front.removeAttribute('aria-hidden');
          front.removeAttribute('inert');
          back.setAttribute('aria-hidden', 'true');
          back.setAttribute('inert', '');
        }
      }
    };

    const closeAllCards = () => {
      cards.forEach((c) => setCardFlipped(c, false));
    };

    // Registrar el último tipo de puntero (mouse vs touch)
    document.addEventListener('pointerdown', (e) => {
      lastPointerType = e.pointerType;
      // Si se toca fuera de las tarjetas en táctil, cerrar
      if (lastPointerType === 'touch') {
        const target = e.target as HTMLElement | null;
        if (!target?.closest('.cards-fan')) {
          closeAllCards();
        }
      }
    });

    cards.forEach((card) => {
      const button = card.querySelector<HTMLButtonElement>('.flip-toggle');

      // Interacción con Ratón: pointerenter / pointerleave
      card.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') {
          setCardFlipped(card, true);
        }
      });

      card.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'mouse') {
          setCardFlipped(card, false);
        }
      });

      // Interacción con Botón (Táctil o Teclado)
      if (button) {
        button.addEventListener('click', (e) => {
          // Si el clic fue emitido tras hover de ratón, no re-alternar
          if (lastPointerType === 'mouse') {
            return;
          }
          const isCurrentlyFlipped = card.dataset.flipped === 'true';
          const nextState = !isCurrentlyFlipped;

          // En táctil, abrir una cierra las demás
          if (nextState) {
            closeAllCards();
          }
          setCardFlipped(card, nextState);
        });
      }
    });

    // Cerrar tarjetas con la tecla Escape
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        closeAllCards();
      }
    });
  })();
</script>
