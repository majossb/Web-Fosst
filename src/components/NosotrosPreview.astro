<!-- ════════════════════════════════════════════════════════════════
     LÓGICA CLIENTE — VOLTEO 3D EN DISPOSITIVOS TÁCTILES Y TECLADO
     ════════════════════════════════════════════════════════════════ -->
<script>
  (() => {
    const nosSection = document.getElementById('nosotros');
    if (!nosSection) return;

    // 1. REVELADO PROGRESIVO DE LÍNEAS Y ELEMENTOS (INTERSECTION OBSERVER)
    const revealElements = () => {
      const revealNodes = nosSection.querySelectorAll<HTMLElement>('.reveal-node, .reveal-line');
      revealNodes.forEach((node) => {
        const delay = node.getAttribute('data-reveal-delay') || '0';
        node.style.transitionDelay = `${delay}ms`;
      });
      nosSection.classList.add('is-revealed');
    };

    if (!('IntersectionObserver' in window)) {
      revealElements();
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          const entry = entries[0];
          if (entry.isIntersecting) {
            revealElements();
          }
        },
        { threshold: 0.15 }
      );
      observer.observe(nosSection);
    }

    // 2. INTERACCIÓN DE VOLTEO 3D EN DISPOSITIVOS TÁCTILES Y TECLADO (LUPI STYLE)
    const flipCards = nosSection.querySelectorAll<HTMLElement>('.flip-card-wrapper');

    flipCards.forEach((card) => {
      const toggleCard = () => {
        const isFlipped = card.classList.contains('is-flipped');
        
        // Alternar estado de la tarjeta tocada
        card.classList.toggle('is-flipped', !isFlipped);
        card.setAttribute('aria-expanded', String(!isFlipped));
      };

      // Tocar en móvil / clic manual
      card.addEventListener('click', (e) => {
        // En dispositivos móviles o clics directos
        toggleCard();
      });

      // Accesibilidad con teclado (Enter y Espacio)
      card.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleCard();
        }
      });
    });
  })();
</script>
