---
// src/components/NarrativeTransition.astro
// Transición narrativa: Conecta la escena del hero con la propuesta de valor real de FOSST
---

<section class="narrative-section" id="nosotros" aria-labelledby="narrative-heading">
  <div class="narrative-glow" aria-hidden="true"></div>

  <div class="narrative-container">
    <!-- Encabezado Editorial Asimétrico -->
    <header class="narrative-header reveal-item">
      <div class="section-eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span class="eyebrow-text">PROPUESTA DE VALOR FOSST</span>
      </div>

      <h2 id="narrative-heading" class="narrative-title">
        Del riesgo visible en la operación a la <em class="title-accent">tranquilidad</em> de tu empresa.
      </h2>

      <p class="narrative-lead">
        Un accidente imprevisto, una visita de inspección del Ministerio o un requerimiento de la ARL no avisan. En FOSST no entregamos carpetas que se quedan en un estante: diagnosticamos la realidad cotidiana de tu empresa y te acompañamos a cerrar cada brecha con rigor técnico.
      </p>
    </header>

    <!-- Composición Asimétrica en Dos Bloques Editoriales -->
    <div class="narrative-grid">
      <!-- Columna 1: El contexto real que enfrentan las empresas -->
      <article class="narrative-card card-challenge reveal-item">
        <div class="card-badge-status">EL DESAFÍO EN COLOMBIA</div>
        <h3 class="card-title">La realidad de la gestión de riesgos hoy</h3>
        <p class="card-desc">
          Muchas organizaciones acumulan documentos para cumplir en el papel, pero continúan desprotegidas en la práctica cotidiana:
        </p>

        <ul class="challenge-list" role="list">
          <li class="challenge-item">
            <span class="item-bullet warning" aria-hidden="true">✕</span>
            <div>
              <strong>Formatos desconectados de la operación:</strong>
              <span>Matrices de riesgo genéricas que los colaboradores no conocen y que no reflejan los peligros reales del puesto de trabajo.</span>
            </div>
          </li>
          <li class="challenge-item">
            <span class="item-bullet warning" aria-hidden="true">✕</span>
            <div>
              <strong>Incertidumbre legal y sanciones:</strong>
              <span>Riesgo de multas por desconocimiento de las resoluciones obligatorias (0312 de 2019, 40595 de 2022 o 2764 de 2022).</span>
            </div>
          </li>
          <li class="challenge-item">
            <span class="item-bullet warning" aria-hidden="true">✕</span>
            <div>
              <strong>Sobrecarga para la gerencia:</strong>
              <span>Tiempo directivo invertido en responder requerimientos urgentes en lugar de enfocarse en el crecimiento del negocio.</span>
            </div>
          </li>
        </ul>
      </article>

      <!-- Columna 2: La propuesta técnica y honesta de FOSST -->
      <article class="narrative-card card-solution reveal-item">
        <div class="card-badge-status solution">EL ENFOQUE FOSST</div>
        <h3 class="card-title">Acompañamiento integral en el terreno</h3>
        <p class="card-desc">
          Integramos seguridad en el trabajo, salud ocupacional, asesoría jurídica y medio ambiente en un solo canal de confianza:
        </p>

        <ul class="challenge-list" role="list">
          <li class="challenge-item">
            <span class="item-bullet success" aria-hidden="true">✓</span>
            <div>
              <strong>Diagnóstico objetivo sin costos ocultos:</strong>
              <span>Evaluamos el nivel de riesgo ARL y el número de trabajadores para aplicar únicamente los estándares que tu empresa legalmente necesita.</span>
            </div>
          </li>
          <li class="challenge-item">
            <span class="item-bullet success" aria-hidden="true">✓</span>
            <div>
              <strong>Controles prácticos y medibles:</strong>
              <span>Capacitación en campo, conformación activa de brigadas, señalización y dotación de EPP ajustada a los riesgos de la labor.</span>
            </div>
          </li>
          <li class="challenge-item">
            <span class="item-bullet success" aria-hidden="true">✓</span>
            <div>
              <strong>Blindaje normativo y continuidad:</strong>
              <span>Respaldamos las decisiones de la dirección ante auditorías de ARL, requerimientos laborales y entes de control ambiental.</span>
            </div>
          </li>
        </ul>

        <div class="card-footer-action">
          <a href="/nosotros" class="narrative-link">
            <span>Conoce más sobre FOSST y nuestro equipo técnico</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </article>
    </div>

    <!-- Franja de Marcos Normativos Oficiales -->
    <footer class="frameworks-strip reveal-item" aria-label="Normatividad técnica aplicada por FOSST">
      <span class="frameworks-label">RESPALDO TÉCNICO Y MARCO LEGAL:</span>
      <div class="frameworks-tags">
        <span class="framework-tag">Resolución 0312 de 2019 (SG-SST)</span>
        <span class="framework-tag">Resolución 40595 de 2022 (PESV)</span>
        <span class="framework-tag">Resolución 2764 de 2022 (Riesgo Psicosocial)</span>
        <span class="framework-tag">Decreto 1072 de 2015</span>
        <span class="framework-tag">Estándares ISO 45001 / 9001 / 14001</span>
      </div>
    </footer>
  </div>
</section>

<style>
  /* ── Animación de revelado para elementos de la sección Nosotros ── */
  .reveal-item {
    opacity: 0;
    transform: translateY(36px);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal-item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  /* Desfases escalonados para entrada natural */
  .narrative-header.reveal-item  { transition-delay: 0ms; }
  .card-challenge.reveal-item    { transition-delay: 130ms; }
  .card-solution.reveal-item     { transition-delay: 260ms; }
  .frameworks-strip.reveal-item  { transition-delay: 390ms; }

  .narrative-section {
    position: relative;
    /* Encima del sticky hero (z-index: 5) para poder deslizarse sobre él */
    z-index: 20;
    /*
      margin-top negativo igual a 1 viewport:
      la sección empieza "escondida" detrás del hero y sube gradualmente
      conforme el usuario scrollea el tramo final del hero-scroll-track.
    */
    margin-top: -100vh;
    background-color: #00143D;
    color: #F7F7F2;
    /* Espacio superior generoso para que el título no quede detrás de la mascota */
    padding: 8rem 1.5rem 6.5rem;
    overflow: hidden;
    /* Esquinas superiores redondeadas estilo tarjeta que emerge */
    border-radius: 32px 32px 0 0;
    /* Sombra hacia arriba que sugiere profundidad */
    box-shadow:
      0 -24px 60px -8px rgba(0, 5, 20, 0.75),
      0 -4px 16px rgba(0, 10, 30, 0.5);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Glow ambiental sutil */
  .narrative-glow {
    position: absolute;
    top: 20%;
    right: 5%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(255, 200, 0, 0.06) 0%, rgba(0, 26, 77, 0) 70%);
    pointer-events: none;
    z-index: 1;
  }

  .narrative-container {
    position: relative;
    z-index: 2;
    max-width: 1280px;
    margin: 0 auto;
  }

  /* Encabezado */
  .narrative-header {
    max-width: 820px;
    margin-bottom: 4rem;
  }

  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
  }
  .eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--yellow, #FFC800);
    box-shadow: 0 0 10px rgba(255, 200, 0, 0.7);
  }
  .eyebrow-text {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--yellow, #FFC800);
    text-transform: uppercase;
  }

  .narrative-title {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    font-weight: 700;
    line-height: 1.18;
    color: #FFFFFF;
    margin: 0 0 1.5rem;
    letter-spacing: -0.015em;
  }
  .title-accent {
    color: var(--yellow, #FFC800);
    font-style: italic;
    font-weight: 600;
  }

  .narrative-lead {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: clamp(1rem, 1.2vw, 1.12rem);
    line-height: 1.7;
    color: rgba(247, 247, 242, 0.85);
    margin: 0;
  }

  /* Grid Asimétrico */
  .narrative-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 3.5rem;
  }
  @media (min-width: 900px) {
    .narrative-grid {
      grid-template-columns: 1fr 1.15fr;
      gap: 2.5rem;
    }
  }

  /* Tarjetas Editoriales */
  .narrative-card {
    border-radius: 16px;
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .card-challenge {
    background: rgba(0, 17, 51, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .card-challenge:hover {
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .card-solution {
    background: linear-gradient(135deg, rgba(0, 26, 77, 0.85) 0%, rgba(0, 17, 51, 0.95) 100%);
    border: 1.5px solid rgba(255, 200, 0, 0.28);
    box-shadow: 0 16px 36px -10px rgba(0, 10, 30, 0.5);
  }
  .card-solution:hover {
    border-color: rgba(255, 200, 0, 0.5);
    transform: translateY(-2px);
  }

  .card-badge-status {
    align-self: flex-start;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(247, 247, 242, 0.85);
    margin-bottom: 1.25rem;
  }
  .card-badge-status.solution {
    background: rgba(255, 200, 0, 0.15);
    color: var(--yellow, #FFC800);
    border: 1px solid rgba(255, 200, 0, 0.35);
  }

  .card-title {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.85rem;
  }

  .card-desc {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.92rem;
    line-height: 1.6;
    color: rgba(247, 247, 242, 0.8);
    margin: 0 0 1.75rem;
  }

  /* Lista de puntos */
  .challenge-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .challenge-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .item-bullet {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 800;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .item-bullet.warning {
    background: rgba(255, 82, 82, 0.15);
    color: #ff5252;
    border: 1px solid rgba(255, 82, 82, 0.3);
  }
  .item-bullet.success {
    background: rgba(0, 230, 118, 0.15);
    color: #00e676;
    border: 1px solid rgba(0, 230, 118, 0.35);
  }

  .challenge-item strong {
    display: block;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.92rem;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 0.2rem;
  }
  .challenge-item span {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.85rem;
    line-height: 1.5;
    color: rgba(247, 247, 242, 0.75);
  }

  .card-footer-action {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .narrative-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--yellow, #FFC800);
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition: gap 0.2s ease, color 0.2s ease;
  }
  .narrative-link:hover {
    gap: 0.8rem;
    color: #ffd01a;
  }

  /* Franja de Marcos Normativos */
  .frameworks-strip {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  @media (min-width: 800px) {
    .frameworks-strip {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .frameworks-label {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: rgba(247, 247, 242, 0.5);
    white-space: nowrap;
  }

  .frameworks-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .framework-tag {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(247, 247, 242, 0.75);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .framework-tag:hover {
    background: rgba(255, 200, 0, 0.08);
    border-color: rgba(255, 200, 0, 0.25);
    color: var(--yellow, #FFC800);
  }

  /* Sin animación: layout normal sin margin negativo ni esquinas */
  @media (prefers-reduced-motion: reduce) {
    .narrative-section {
      margin-top: 0 !important;
      border-radius: 0 !important;
      box-shadow: none !important;
    }
  }
</style>

<script>
  (() => {
    const items = Array.from(
      document.querySelectorAll<HTMLElement>('#nosotros .reveal-item')
    );
    if (!items.length) return;

    // Accesibilidad: reducción de movimiento → mostrar todo inmediatamente
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      items.forEach((el) => el.classList.add('is-visible'));
      return;
    }

    if (!('IntersectionObserver' in window)) {
      // Fallback para navegadores muy antiguos
      items.forEach((el) => el.classList.add('is-visible'));
      return;
    }

    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.12,
        rootMargin: '0px 0px -48px 0px',
      }
    );

    items.forEach((el) => obs.observe(el));

    // Limpiar al navegar con Astro View Transitions
    document.addEventListener('astro:before-swap', () => {
      obs.disconnect();
    }, { once: true });
  })();
</script>
