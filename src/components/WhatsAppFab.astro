---
/**
 * Botón flotante accesible de WhatsApp para FOSST
 * Canal directo de asesoría inmediata
 */
interface Props {
  phoneNumber?: string;
  defaultMessage?: string;
}

const {
  phoneNumber = '573203865953',
  defaultMessage = 'Hola FOSST, deseo consultar información sobre el diagnóstico y gestión de riesgos para mi empresa.'
} = Astro.props;

const encodedMsg = encodeURIComponent(defaultMessage);
const waUrl = `https://wa.me/${phoneNumber}?text=${encodedMsg}`;
---

<aside class="wa-fab-container" aria-label="Contacto rápido por WhatsApp">
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="wa-fab-btn"
    aria-label="Hablar con un especialista de FOSST en WhatsApp"
  >
    <!-- Ícono SVG limpio estilo Solar/Phosphor -->
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path
        d="M20.5 12C20.5 16.6944 16.6944 20.5 12 20.5C10.4284 20.5 8.95079 20.0736 7.6845 19.3308L3.5 20.5L4.69739 16.3683C3.93514 15.0874 3.5 13.595 3.5 12C3.5 7.30558 7.30558 3.5 12 3.5C16.6944 3.5 20.5 7.30558 20.5 12Z"
        fill="#25D366"
      />
      <path
        d="M9.25 8.75C9.05 8.35 8.85 8.35 8.65 8.35C8.45 8.35 8.25 8.35 8.05 8.55C7.85 8.75 7.35 9.25 7.35 10.25C7.35 11.25 8.1 12.25 8.2 12.4C8.3 12.55 9.65 14.75 11.8 15.65C13.6 16.4 14 16.2 14.4 16.15C14.8 16.1 15.7 15.6 15.9 15.05C16.1 14.5 16.1 14.05 16.05 13.95C16 13.85 15.8 13.8 15.5 13.65C15.2 13.5 13.8 12.8 13.55 12.7C13.3 12.6 13.15 12.55 13 12.8C12.85 13.05 12.35 13.65 12.2 13.8C12.05 13.95 11.9 14 11.6 13.85C11.3 13.7 10.35 13.4 9.25 12.4C8.4 11.65 7.85 10.7 7.7 10.45C7.55 10.2 7.7 10.05 7.85 9.9C8 9.75 8.15 9.55 8.3 9.4C8.45 9.25 8.5 9.15 8.6 8.95C8.7 8.75 8.65 8.6 8.6 8.5C8.55 8.4 9.4 6.7 9.25 8.75Z"
        fill="#FFFFFF"
      />
    </svg>
    <span class="wa-tooltip">Asesoría WhatsApp</span>
  </a>
</aside>

<style>
  .wa-fab-container {
    position: fixed;
    bottom: var(--spacing-400);
    right: var(--spacing-400);
    z-index: 9980;
  }

  .wa-fab-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px; /* Touch target >= 44px */
    background: #000F2E;
    border: 2px solid #25D366;
    border-radius: var(--radius-full);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    transition: transform var(--duration-hover) var(--ease-fluid),
                box-shadow var(--duration-hover) ease;
    position: relative;
    text-decoration: none;
  }

  .wa-fab-btn:hover {
    transform: scale(1.08) translateY(-2px);
    box-shadow: 0 12px 30px rgba(37, 211, 102, 0.35);
  }

  .wa-fab-btn:active {
    transform: scale(0.96);
  }

  .wa-tooltip {
    position: absolute;
    right: 64px;
    background: var(--azul-profundo);
    color: var(--blanco-calido);
    padding: var(--spacing-50) var(--spacing-100);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    line-height: var(--lh-xs);
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translateX(8px);
    transition: opacity var(--duration-state) ease, transform var(--duration-state) var(--ease-fluid);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .wa-fab-btn:hover .wa-tooltip {
    opacity: 1;
    transform: translateX(0);
  }
</style>
