---
// src/components/CtaBanner.astro
// Cierre con llamadas a la acción directas hacia Diagnóstico, Servicios y Contacto
---

<section class="cta-banner-section" id="diagnostico" aria-labelledby="cta-banner-heading">
  <div class="cta-banner-glow" aria-hidden="true"></div>

  <div class="cta-banner-container">
    <div class="cta-card">
      <div class="section-eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span class="eyebrow-text">PASO SIGUIENTE</span>
      </div>

      <h2 id="cta-banner-heading" class="cta-title">
        Empieza a ordenar la seguridad y salud de tu empresa <em class="title-accent">hoy mismo</em>.
      </h2>

      <p class="cta-desc">
        Un diagnóstico a tiempo previene requerimientos sancionatorios, protege a tus trabajadores y te brinda la tranquilidad jurídica y operativa para concentrarte en hacer crecer tu negocio.
      </p>

      <!-- Botones de Acción -->
      <div class="cta-actions-group">
        <a href="/diagnostico" class="cta-btn btn-primary" id="cta-btn-diag">
          <span>Realizar diagnóstico gratuito</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a
          href="https://wa.me/573203865953?text=Hola%20FOSST%2C%20quisiera%20solicitar%20asesor%C3%ADa%20para%20mi%20empresa."
          target="_blank"
          rel="noopener noreferrer"
          class="cta-btn btn-whatsapp"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          <span>Hablar por WhatsApp</span>
        </a>

        <a href="/contacto" class="cta-btn btn-secondary">
          <span>Formulario de contacto</span>
        </a>
      </div>

      <!-- Garantías de Confianza -->
      <div class="cta-trust-items" role="list">
        <div class="trust-item" role="listitem">
          <span class="trust-check" aria-hidden="true">✓</span>
          <span>Sin costo ni compromiso para el diagnóstico inicial</span>
        </div>
        <div class="trust-item" role="listitem">
          <span class="trust-check" aria-hidden="true">✓</span>
          <span>Confidencialidad absoluta de tu información</span>
        </div>
        <div class="trust-item" role="listitem">
          <span class="trust-check" aria-hidden="true">✓</span>
          <span>Respuesta de nuestro equipo en menos de 24 horas</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-banner-section {
    position: relative;
    background-color: #000F2E;
    color: #F7F7F2;
    padding: 7rem 1.5rem 8rem;
    overflow: hidden;
  }

  .cta-banner-glow {
    position: absolute;
    bottom: -150px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 400px;
    background: radial-gradient(circle, rgba(255, 200, 0, 0.12) 0%, rgba(0, 26, 77, 0) 70%);
    pointer-events: none;
    z-index: 1;
  }

  .cta-banner-container {
    position: relative;
    z-index: 2;
    max-width: 1060px;
    margin: 0 auto;
  }

  .cta-card {
    background: linear-gradient(135deg, rgba(0, 26, 77, 0.9) 0%, rgba(0, 17, 51, 0.95) 100%);
    border: 1.5px solid rgba(255, 200, 0, 0.35);
    border-radius: 24px;
    padding: 4rem 2.5rem;
    text-align: center;
    box-shadow: 0 20px 50px -15px rgba(0, 10, 30, 0.7);
  }
  @media (max-width: 640px) {
    .cta-card {
      padding: 3rem 1.5rem;
    }
  }

  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
  }
  .eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--yellow, #FFC800);
    box-shadow: 0 0 10px rgba(255, 200, 0, 0.7);
  }
  .eyebrow-text {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--yellow, #FFC800);
    text-transform: uppercase;
  }

  .cta-title {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 700;
    line-height: 1.2;
    color: #FFFFFF;
    margin: 0 auto 1.35rem;
    max-width: 800px;
  }
  .title-accent {
    color: var(--yellow, #FFC800);
    font-style: italic;
    font-weight: 600;
  }

  .cta-desc {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: clamp(1rem, 1.2vw, 1.1rem);
    line-height: 1.68;
    color: rgba(247, 247, 242, 0.85);
    margin: 0 auto 2.75rem;
    max-width: 680px;
  }

  /* Grupo de Botones */
  .cta-actions-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    flex-wrap: wrap;
    margin-bottom: 2.75rem;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.95rem;
    text-decoration: none;
    padding: 0.95rem 1.85rem;
    border-radius: 9999px;
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, background-color 0.25s ease, border-color 0.25s ease;
  }

  .btn-primary {
    background: var(--yellow, #FFC800);
    color: #001A4D;
    font-weight: 700;
    border: 2px solid var(--yellow, #FFC800);
    box-shadow: 0 8px 24px -4px rgba(255, 200, 0, 0.5);
  }
  .btn-primary:hover {
    background: #ffd01a;
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 12px 30px -2px rgba(255, 200, 0, 0.65);
  }

  .btn-whatsapp {
    background: rgba(37, 211, 102, 0.12);
    color: #25D366;
    font-weight: 700;
    border: 1.5px solid rgba(37, 211, 102, 0.4);
  }
  .btn-whatsapp:hover {
    background: #25D366;
    color: #001A4D;
    border-color: #25D366;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(37, 211, 102, 0.35);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.06);
    color: #FFFFFF;
    font-weight: 600;
    border: 1.5px solid rgba(255, 255, 255, 0.25);
  }
  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.5);
    transform: translateY(-2px);
  }

  /* Garantías */
  .cta-trust-items {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.75rem;
    flex-wrap: wrap;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.82rem;
    color: rgba(247, 247, 242, 0.75);
  }
  .trust-check {
    color: var(--yellow, #FFC800);
    font-weight: 800;
  }
</style>
