---
// src/components/Hero.astro
// FOSST Consultoría Integral — Hero con Carrusel Fotográfico y Cursor Reveal
// Categorías oficiales: Gestión ambiental, Riesgo psicosocial, Seguridad vial (PESV)
---

<header class="fosst-header">
  <div class="header-backdrop" aria-hidden="true"></div>
  <div class="header-container">
    <a href="#inicio" class="logo-link" aria-label="FOSST Consultoría Integral - Inicio">
      <img
        src="/images/fosst-logo.png"
        alt="FOSST Consultoría Integral"
        class="fosst-logo-img"
        width="216"
        height="38"
        loading="eager"
        decoding="async"
      />
    </a>

    <nav class="nav-desktop" aria-label="Navegación principal">
      <ul class="nav-list">
        <li>
          <a href="#inicio" class="nav-link active">
            <span>Inicio</span>
            <span class="active-indicator" aria-hidden="true"></span>
          </a>
        </li>
        <li class="has-dropdown">
          <a href="#servicios" class="nav-link">
            <span>Servicios</span>
            <svg class="chevron-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
        </li>
        <li><a href="#diagnostico" class="nav-link">Diagnóstico</a></li>
        <li><a href="#portafolio" class="nav-link">Portafolio</a></li>
        <li><a href="#nosotros" class="nav-link">Nosotros</a></li>
        <li><a href="#contacto" class="nav-link">Contacto</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <button class="search-btn" aria-label="Buscar en el sitio" type="button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <a href="#diagnostico" class="header-cta-btn">
        <span>Agenda tu diagnóstico</span>
        <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>

      <button class="mobile-toggle" aria-label="Abrir menú" aria-expanded="false" id="mobile-toggle" type="button">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <div class="nav-mobile" id="mobile-menu" aria-hidden="true">
    <ul class="mobile-nav-list">
      <li><a href="#inicio" class="mobile-nav-link active">Inicio</a></li>
      <li><a href="#servicios" class="mobile-nav-link">Servicios</a></li>
      <li><a href="#diagnostico" class="mobile-nav-link">Diagnóstico</a></li>
      <li><a href="#portafolio" class="mobile-nav-link">Portafolio</a></li>
      <li><a href="#nosotros" class="mobile-nav-link">Nosotros</a></li>
      <li><a href="#contacto" class="mobile-nav-link">Contacto</a></li>
      <li class="mobile-cta-item">
        <a href="#diagnostico" class="mobile-cta-btn">
          <span>Agenda tu diagnóstico</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </li>
    </ul>
  </div>
</header>

<!-- ════════════════════════════════════════════════════════════════════
     HERO SECTION — Fotografía Full-Bleed con Cursor Reveal Effect & Transición LUPI
     ════════════════════════════════════════════════════════════════════ -->
<div class="hero-scroll-track" id="hero-scroll-track">
  <section class="hero-section" id="inicio">

    <!-- Contenedor visual del Hero que se contrae y recoge de forma progresiva con el scroll -->
    <div class="hero-card-stage" id="hero-card-stage">

  <!-- ── CAPAS FOTOGRÁFICAS FULL-BLEED (z: 1..4) ── -->
  <div class="hero-bg" aria-hidden="true">

    <!-- CAPA BASE: Escenas laborales de alta resolución sin controles (z: 1) -->
    <div class="bg-base-layer" id="bg-base-layer">
      <img src="/images/hero/ambiental-base.png"
           alt="" class="bg-img active" data-slide="0"
           loading="eager" fetchpriority="high" decoding="async" />
      <img src="/images/hero/psicosocial-base.png"
           alt="" class="bg-img" data-slide="1"
           loading="lazy" decoding="async" />
      <img src="/images/hero/pesv-base.png"
           alt="" class="bg-img" data-slide="2"
           loading="lazy" decoding="async" />
    </div>

    <!-- DEGRADADO EDITORIAL DE LECTURA (z: 2): protege el texto a la izquierda, 100% transparente a la derecha -->
    <div class="hero-overlay"></div>

    <!-- CAPA DE REVELADO: Misma escena con controles preventivos FOSST (z: 4, sobre el overlay) -->
    <div class="bg-reveal-layer" id="bg-reveal-layer">
      <img src="/images/hero/ambiental-control.png"
           alt="Controles ambientales FOSST revelados" class="bg-img active" data-slide="0"
           loading="eager" fetchpriority="high" decoding="async" />
      <img src="/images/hero/psicosocial-control.png"
           alt="Controles psicosociales y organizacionales revelados" class="bg-img" data-slide="1"
           loading="lazy" decoding="async" />
      <img src="/images/hero/pesv-control.png"
           alt="Plan Estratégico de Seguridad Vial PESV revelado" class="bg-img" data-slide="2"
           loading="lazy" decoding="async" />
    </div>

    <!-- ILUMINACIÓN DE BORDE ORGÁNICA: difusión tenue ámbar acoplada al círculo revelado -->
    <div class="reveal-glow-layer" id="reveal-glow" aria-hidden="true"></div>
  </div>

  <!-- ── PUNTOS DE INTERÉS VINCULADOS A EPP Y CONTROLES FÍSICOS (z: 6) ── -->
  <!-- Aparecen ÚNICAMENTE al pasar el cursor exactamente sobre el lugar específico -->
  <!-- Orientados hacia la derecha o zonas despejadas para NUNCA estorbar con el texto -->
  <div class="hotspots-layer" id="hotspots-layer" aria-live="polite">

    <!-- Escenario 0 — Gestión ambiental -->
    <div class="hotspots-group active" data-group="0">
      <!-- Hotspot 1: EPP Protección respiratoria y visual en rostro del operario -->
      <div class="hotspot-item" style="left: 62%; top: 17%;" data-hx="62" data-hy="17" data-label="respirador">
        <span class="hotspot-marker" aria-hidden="true"></span>
        <div class="hotspot-card pos-right">
          <svg class="hotspot-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FFC800" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="7" r="4"></circle>
            <path d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"></path>
          </svg>
          <div class="hotspot-info">
            <strong>Protección respiratoria y visual</strong>
            <span>Respirador N95/químico y monogafas con sello hermético contra vapores.</span>
          </div>
        </div>
      </div>

      <!-- Hotspot 2: EPP Guantes de nitrilo en manos del operario -->
      <div class="hotspot-item" style="left: 59%; top: 37%;" data-hx="59" data-hy="37" data-label="guantes">
        <span class="hotspot-marker" aria-hidden="true"></span>
        <div class="hotspot-card pos-right">
          <svg class="hotspot-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FFC800" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0"></path>
            <path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v2"></path>
            <path d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8"></path>
            <path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"></path>
          </svg>
          <div class="hotspot-info">
            <strong>Guantes de nitrilo certificados</strong>
            <span>Protección dérmica de caña larga resistente a sustancias químicas.</span>
          </div>
        </div>
      </div>

      <!-- Hotspot 3: Contención y trasvase seguro en contenedor secundario -->
      <div class="hotspot-item" style="left: 72%; top: 62%;" data-hx="72" data-hy="62" data-label="contencion">
        <span class="hotspot-marker" aria-hidden="true"></span>
        <div class="hotspot-card pos-right">
          <svg class="hotspot-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FFC800" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <div class="hotspot-info">
            <strong>Contención y trasvase seguro</strong>
            <span>Contenedor secundario para prevención de derrames y vertimientos accidentales.</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Escenario 1 — Riesgo psicosocial -->
    <div class="hotspots-group" data-group="1">
      <!-- Hotspot 1: Ergonomía postural en trabajadora y silla ergonómica -->
      <div class="hotspot-item" style="left: 65%; top: 40%;" data-hx="65" data-hy="40" data-label="postura">
        <span class="hotspot-marker" aria-hidden="true"></span>
        <div class="hotspot-card pos-right">
          <svg class="hotspot-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FFC800" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="5" r="3"></circle>
            <path d="M12 8v8"></path>
            <path d="m8 13 4 2 4-2"></path>
            <path d="m9 21 3-5 3 5"></path>
          </svg>
          <div class="hotspot-info">
            <strong>Ergonomía y postura intralaboral</strong>
            <span>Silla ergonómica con soporte lumbar, apoyo antebraquial y alineación visual.</span>
          </div>
        </div>
      </div>

      <!-- Hotspot 2: Tablero de planeación y gestión de carga en pared -->
      <div class="hotspot-item" style="left: 90%; top: 28%;" data-hx="90" data-hy="28" data-label="planeacion">
        <span class="hotspot-marker" aria-hidden="true"></span>
        <div class="hotspot-card pos-left">
          <svg class="hotspot-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FFC800" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
          </svg>
          <div class="hotspot-info">
            <strong>Gestión visual de carga laboral</strong>
            <span>Tablero de planeación y balance de tareas para mitigar la sobrecarga mental.</span>
          </div>
        </div>
      </div>

      <!-- Hotspot 3: Organización del puesto de trabajo y agenda -->
      <div class="hotspot-item" style="left: 80%; top: 74%;" data-hx="80" data-hy="74" data-label="despacho">
        <span class="hotspot-marker" aria-hidden="true"></span>
        <div class="hotspot-card pos-left">
          <svg class="hotspot-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FFC800" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
          <div class="hotspot-info">
            <strong>Organización del puesto (5S)</strong>
            <span>Puesto ordenado y despejado para favorecer la concentración y bienestar.</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Escenario 2 — Seguridad vial (PESV) -->
    <div class="hotspots-group" data-group="2">
      <!-- Hotspot 1: EPP Vial (Chaleco reflectivo) y Lista de Chequeo -->
      <div class="hotspot-item" style="left: 52%; top: 36%;" data-hx="52" data-hy="36" data-label="chaleco">
        <span class="hotspot-marker" aria-hidden="true"></span>
        <div class="hotspot-card pos-right">
          <svg class="hotspot-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FFC800" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
          </svg>
          <div class="hotspot-info">
            <strong>Inspección preoperacional PESV</strong>
            <span>Chaleco reflectivo reglamentario y formato diario de verificación técnico-mecánica.</span>
          </div>
        </div>
      </div>

      <!-- Hotspot 2: Aseguramiento mecánico (Cuña de bloqueo en llanta) -->
      <div class="hotspot-item" style="left: 65%; top: 70%;" data-hx="65" data-hy="70" data-label="cunas">
        <span class="hotspot-marker" aria-hidden="true"></span>
        <div class="hotspot-card pos-top">
          <svg class="hotspot-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FFC800" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 14 14"></polyline>
          </svg>
          <div class="hotspot-info">
            <strong>Aseguramiento vehicular (cuñas)</strong>
            <span>Cuñas de parqueo en llantas para prevención de rodamiento imprevisto.</span>
          </div>
        </div>
      </div>

      <!-- Hotspot 3: Señalización perimetral reflectiva (Triángulo de emergencia) -->
      <div class="hotspot-item" style="left: 74%; top: 67%;" data-hx="74" data-hy="67" data-label="triangulo">
        <span class="hotspot-marker" aria-hidden="true"></span>
        <div class="hotspot-card pos-top">
          <svg class="hotspot-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FFC800" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          <div class="hotspot-info">
            <strong>Señalización perimetral reflectiva</strong>
            <span>Triángulos de seguridad reflectivos para delimitación segura del área.</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── CONTENIDO EDITORIAL DE PRIMER PLANO (z: 10, completamente despejado) ── -->
  <div class="hero-content-wrap">
    <div class="hero-content">
      <!-- Eyebrow -->
      <div class="hero-eyebrow">
        <span class="eyebrow-line" aria-hidden="true"></span>
        <span class="eyebrow-text">CONSULTORÍA EN SEGURIDAD Y SALUD EN EL TRABAJO</span>
      </div>

      <!-- Titular -->
      <h1 class="hero-headline">
        Empresas que <em class="headline-accent">cuidan</em> a su gente, llegan más lejos.
      </h1>

      <!-- Subtítulo -->
      <p class="hero-description">
        Diagnosticamos el estado real de tu organización, te mostramos dónde están los riesgos y te acompañamos a cerrarlos, todo en un solo lugar.
      </p>

      <!-- Botones de Acción -->
      <div class="hero-actions">
        <a href="#diagnostico" class="btn btn-primary">
          <span>Realizar diagnóstico</span>
          <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="#servicios" class="btn btn-secondary">
          <span>Explorar servicios</span>
          <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <!-- Indicadores de Confianza -->
      <div class="hero-badges" role="list" aria-label="Pilares de servicio FOSST">
        <div class="badge-item" role="listitem">
          <div class="badge-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFC800" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="M9 12l2 2 4-4"></path>
            </svg>
          </div>
          <span class="badge-label">Prevención<br/>de riesgos</span>
        </div>
        <div class="badge-item" role="listitem">
          <div class="badge-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFC800" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
          </div>
          <span class="badge-label">Diagnóstico<br/>empresarial</span>
        </div>
        <div class="badge-item" role="listitem">
          <div class="badge-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFC800" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
              <polyline points="9 16 11 18 15 14"></polyline>
            </svg>
          </div>
          <span class="badge-label">Gestión<br/>en línea</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ── DOCK INFERIOR CENTRAL: CONTROLES DEL CARRUSEL UNIFICADOS EN EL CENTRO (z: 20) ── -->
  <div class="hero-dock">
    <div class="dock-inner">
      <div class="dock-carousel-bar" role="toolbar" aria-label="Controles del carrusel">
        <!-- Flecha Anterior -->
        <button type="button" class="dock-arrow" id="btn-prev" aria-label="Categoría anterior">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <!-- Pestañas de las 3 Categorías Oficiales -->
        <div class="dock-tabs" role="tablist" aria-label="Categorías de consultoría">
          <button type="button" class="dock-tab active" role="tab" aria-selected="true" data-index="0">
            <svg class="tab-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
              <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
            </svg>
            <span>Gestión ambiental</span>
          </button>
          <button type="button" class="dock-tab" role="tab" aria-selected="false" data-index="1">
            <svg class="tab-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            <span>Riesgo psicosocial</span>
          </button>
          <button type="button" class="dock-tab" role="tab" aria-selected="false" data-index="2">
            <svg class="tab-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
            <span>Seguridad vial (PESV)</span>
          </button>
        </div>

        <!-- Divisor sutil -->
        <span class="dock-divider" aria-hidden="true"></span>

        <!-- Marcadores de Puntos Indicadores -->
        <div class="dock-dots" aria-label="Indicadores de diapositiva">
          <button type="button" class="dock-dot active" data-index="0" aria-label="Gestión ambiental"></button>
          <button type="button" class="dock-dot" data-index="1" aria-label="Riesgo psicosocial"></button>
          <button type="button" class="dock-dot" data-index="2" aria-label="Seguridad vial"></button>
        </div>

        <!-- Flecha Siguiente -->
        <button type="button" class="dock-arrow" id="btn-next" aria-label="Categoría siguiente">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

      <!-- Barra de Comparación en Dispositivos Táctiles -->
      <div class="mobile-toggle-bar" id="mobile-compare" role="group" aria-label="Comparar situación y control">
        <button type="button" class="cmp-btn active" id="btn-risk" aria-pressed="true">
          <span class="cmp-dot risk"></span> Sin intervención
        </button>
        <button type="button" class="cmp-btn" id="btn-control" aria-pressed="false">
          <span class="cmp-dot ok"></span> Con control FOSST
        </button>
      </div>
    </div>
  </div>

  <!-- Píldora Guía de Descubrimiento -->
  <div class="guide-pill" id="guide-pill" aria-hidden="true">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FFC800" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <span class="guide-desk">Pasa el cursor sobre los elementos de la escena para descubrir cada control</span>
    <span class="guide-touch">Toca los puntos en pantalla para explorar los controles</span>
  </div>
    </div><!-- Fin .hero-card-stage -->

    <!-- ── MASCOTA OFICIAL FOSST (PUENTE VISUAL HERO → NOSOTROS) ── -->
    <aside class="hero-mascot-bridge" id="hero-mascot-bridge" aria-label="Mascota oficial FOSST">
      <div class="mascot-figure">
        <picture>
          <source srcset="/images/mascot-fosst.webp" type="image/webp" />
          <img
            src="/images/mascot-fosst.png"
            alt="Mascota oficial FOSST con casco amarillo de seguridad"
            class="mascot-img"
            width="316"
            height="562"
            loading="eager"
            decoding="async"
          />
        </picture>
        <div class="mascot-ground-shadow" aria-hidden="true"></div>
      </div>
    </aside>

  </section>
</div>

<!-- ════════════════════════════════════════════════════════════════════
     LÓGICA CLIENTE — Hover Reveal + Activación Puntual en Lugar Específico
     ════════════════════════════════════════════════════════════════════ -->
<script>
  // Menú móvil
  const toggleBtn = document.getElementById('mobile-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const open = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!open));
      toggleBtn.classList.toggle('is-open');
      mobileMenu.classList.toggle('is-open');
      mobileMenu.setAttribute('aria-hidden', String(open));
    });
    mobileMenu.querySelectorAll('.mobile-nav-link, .mobile-cta-btn').forEach((l) =>
      l.addEventListener('click', () => {
        toggleBtn.setAttribute('aria-expanded', 'false');
        toggleBtn.classList.remove('is-open');
        mobileMenu.classList.remove('is-open');
        mobileMenu.setAttribute('aria-hidden', 'true');
      })
    );
  }

  // Controlador interactivo del Hero
  (() => {
    const hero = document.getElementById('inicio') as HTMLElement | null;
    const track = document.getElementById('hero-scroll-track') as HTMLElement | null;
    const stage = (document.getElementById('hero-card-stage') || hero) as HTMLElement | null;
    const mascotBridge = document.getElementById('hero-mascot-bridge') as HTMLElement | null;
    const heroDock = hero ? (hero.querySelector('.hero-dock') as HTMLElement | null) : null;
    const revealLayer = document.getElementById('bg-reveal-layer') as HTMLElement | null;
    const revealGlow = document.getElementById('reveal-glow') as HTMLElement | null;
    const guidePill = document.getElementById('guide-pill') as HTMLElement | null;
    const tabs = document.querySelectorAll<HTMLButtonElement>('.dock-tab');
    const dots = document.querySelectorAll<HTMLButtonElement>('.dock-dot');
    const prevBtn = document.getElementById('btn-prev');
    const nextBtn = document.getElementById('btn-next');
    const btnRisk = document.getElementById('btn-risk');
    const btnControl = document.getElementById('btn-control');

    if (!hero || !revealLayer) return;

    const TOTAL = 3;
    const AUTOPLAY_MS = 10000;
    let current = 0;
    let autoTimer: number | null = null;
    let autoPaused = false;

    // Estado del cursor e interpolación
    let spotX = -9999, spotY = -9999;
    let targetX = -9999, targetY = -9999;
    let hovering = false;
    let touching = false;
    let forcedReveal = false;
    let rafId = 0;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Radio de la linterna de revelado
    const RADIUS = 260;

    // Radio estricto de activación puntual (SOLO aparece al pasar directamente sobre el control específico)
    const ACTIVATION_RADIUS = 40;

    // Aplica máscara circular radial a la imagen de control
    const applyMask = (x: number, y: number) => {
      if (forcedReveal) {
        revealLayer.style.maskImage = 'none';
        revealLayer.style.webkitMaskImage = 'none';
        revealLayer.classList.add('is-active');
        if (revealGlow) revealGlow.style.opacity = '0';
        return;
      }
      const px = `${x.toFixed(1)}px`;
      const py = `${y.toFixed(1)}px`;

      // Máscara suave con borde orgánico
      const mask = `radial-gradient(circle ${RADIUS}px at ${px} ${py}, #000 0%, #000 52%, rgba(0,0,0,0.65) 76%, rgba(0,0,0,0.15) 92%, transparent 100%)`;
      revealLayer.style.maskImage = mask;
      revealLayer.style.webkitMaskImage = mask;

      // Resplandor cálido tenue exterior conectado a la linterna
      if (revealGlow) {
        const glowMask = `radial-gradient(circle ${RADIUS + 30}px at ${px} ${py}, transparent ${RADIUS - 30}px, rgba(255, 200, 0, 0.08) ${RADIUS}px, transparent ${RADIUS + 30}px)`;
        revealGlow.style.background = glowMask;
        revealGlow.style.opacity = '1';
      }

      // Comprobación de proximidad euclidiana 2D precisa al control específico
      checkSpecificHotspotProximity(x, y);
    };

    // Comprueba si el cursor está directamente encima de algún EPP o control específico
    const checkSpecificHotspotProximity = (cx: number, cy: number) => {
      const activeGroup = hero.querySelector(`.hotspots-group[data-group="${current}"]`);
      if (!activeGroup) return;

      const rect = (stage || hero).getBoundingClientRect();
      const items = Array.from(activeGroup.querySelectorAll<HTMLElement>('.hotspot-item'));

      if (forcedReveal) {
        items.forEach((item) => item.classList.add('is-revealed'));
        return;
      }

      // Encontrar el control específico más cercano dentro del radio puntual estricto (máximo 1 activo a la vez)
      let closestItem: HTMLElement | null = null;
      let minDistance = ACTIVATION_RADIUS;

      items.forEach((item) => {
        const hxPercent = parseFloat(item.getAttribute('data-hx') || '0');
        const hyPercent = parseFloat(item.getAttribute('data-hy') || '0');

        const hx = (hxPercent / 100) * rect.width;
        const hy = (hyPercent / 100) * rect.height;

        const dist = Math.hypot(cx - hx, cy - hy);
        if (dist <= minDistance) {
          minDistance = dist;
          closestItem = item;
        }
      });

      // Activar ÚNICAMENTE el control específico sobre el que pasa el cursor
      items.forEach((item) => {
        if (item === closestItem) {
          item.classList.add('is-revealed');
        } else {
          item.classList.remove('is-revealed');
        }
      });
    };

    const showReveal = () => {
      revealLayer.classList.add('is-active');
      guidePill?.classList.add('hidden');
    };

    const hideReveal = () => {
      if (forcedReveal) return;
      revealLayer.classList.remove('is-active');
      guidePill?.classList.remove('hidden');
      if (revealGlow) revealGlow.style.opacity = '0';

      // Ocultar tarjetas al salir el cursor del hero
      const activeGroup = hero.querySelector(`.hotspots-group[data-group="${current}"]`);
      activeGroup?.querySelectorAll('.hotspot-item').forEach((item) => {
        item.classList.remove('is-revealed');
      });
    };

    // Bucle de animación suave con interpolación
    const loop = () => {
      if (hovering || touching) {
        const f = reducedMotion ? 1 : 0.14;
        spotX += (targetX - spotX) * f;
        spotY += (targetY - spotY) * f;
        applyMask(spotX, spotY);
      }
      rafId = requestAnimationFrame(loop);
    };

    // Eventos de ratón sobre el hero completo
    const onEnter = (e: MouseEvent) => {
      pauseAuto();
      const r = (stage || hero).getBoundingClientRect();
      targetX = e.clientX - r.left;
      targetY = e.clientY - r.top;
      spotX = targetX;
      spotY = targetY;
      hovering = true;
      applyMask(spotX, spotY);
      showReveal();
    };

    const onMove = (e: MouseEvent) => {
      if (!hovering) { onEnter(e); return; }
      const r = (stage || hero).getBoundingClientRect();
      targetX = e.clientX - r.left;
      targetY = e.clientY - r.top;
    };

    const onLeave = () => {
      hovering = false;
      hideReveal();
      resumeAuto();
    };

    // Eventos táctiles
    const onTouchStart = (e: TouchEvent) => {
      if (!e.touches.length) return;
      pauseAuto();
      const t = e.touches[0];
      const r = (stage || hero).getBoundingClientRect();
      targetX = t.clientX - r.left;
      targetY = t.clientY - r.top;
      spotX = targetX;
      spotY = targetY;
      touching = true;
      applyMask(spotX, spotY);
      showReveal();
    };

    const onTouchMove = (e: TouchEvent) => {
      if (!e.touches.length) return;
      const t = e.touches[0];
      const r = (stage || hero).getBoundingClientRect();
      targetX = t.clientX - r.left;
      targetY = t.clientY - r.top;
    };

    const onTouchEnd = () => {
      touching = false;
      hideReveal();
      resumeAuto();
    };

    // ══════════════════════════════════════════════════════════
    // TRANSICIÓN DE RECOGIMIENTO CON GSAP SCROLLTRIGGER (scrub)
    // ══════════════════════════════════════════════════════════
    // Importamos GSAP + ScrollTrigger dinámicamente para no bloquear el hilo principal
    if (!reducedMotion && track && hero) {
      import('gsap').then(({ gsap }) => {
        import('gsap/ScrollTrigger').then(({ ScrollTrigger }) => {
          gsap.registerPlugin(ScrollTrigger);

          ScrollTrigger.create({
            trigger: track,
            start: 'top top',      // cuando el top del track toca el top del viewport
            end: 'bottom bottom',  // cuando el bottom del track toca el bottom del viewport
            scrub: 0.6,            // suavizado de 0.6 s para 60 fps fluido
            onUpdate: (self) => {
              const p = self.progress;

              // --hero-progress: controla escala, esquinas, sombra del card-stage
              // y desvanece el contenido editorial
              hero.style.setProperty('--hero-progress', p.toFixed(4));

              // --mascot-progress: la mascota sube durante el primer 65 % del recorrido
              const mascotP = Math.min(1, Math.max(0, (p - 0.03) / 0.62));
              hero.style.setProperty('--mascot-progress', mascotP.toFixed(4));

              // Deshabilitar clics en el dock mientras se recoge (> 12 % de progreso)
              if (p > 0.12) {
                heroDock?.style.setProperty('pointer-events', 'none');
              } else {
                heroDock?.style.removeProperty('pointer-events');
              }
            },
          });

          // Limpiar al navegar con Astro View Transitions
          document.addEventListener('astro:before-swap', () => {
            ScrollTrigger.getAll().forEach((t) => t.kill());
          }, { once: true });
        });
      });
    }

    // Cambio de escenario coordinado
    const setScenario = (idx: number) => {
      current = ((idx % TOTAL) + TOTAL) % TOTAL;

      // Cambiar imágenes base y reveladas juntas
      hero.querySelectorAll('.bg-img').forEach((img) => {
        img.classList.toggle('active', Number(img.getAttribute('data-slide')) === current);
      });

      // Cambiar grupo de tarjetas y limpiar estados previos
      hero.querySelectorAll('.hotspots-group').forEach((g, i) => {
        const isActive = i === current;
        g.classList.toggle('active', isActive);
        if (!isActive) {
          g.querySelectorAll('.hotspot-item').forEach((item) => item.classList.remove('is-revealed'));
        }
      });

      // Actualizar pestañas y puntos del dock central
      tabs.forEach((t, i) => {
        t.classList.toggle('active', i === current);
        t.setAttribute('aria-selected', String(i === current));
      });
      dots.forEach((d, i) => d.classList.toggle('active', i === current));

      // Reiniciar estado del revelado
      hovering = false;
      touching = false;
      forcedReveal = false;
      spotX = spotY = targetX = targetY = -9999;
      hideReveal();

      // Resetear botones táctiles
      btnRisk?.classList.add('active');
      btnRisk?.setAttribute('aria-pressed', 'true');
      btnControl?.classList.remove('active');
      btnControl?.setAttribute('aria-pressed', 'false');
    };

    // Autoplay discreto
    const startAuto = () => {
      if (reducedMotion) return;
      stopAuto();
      autoTimer = window.setInterval(() => {
        if (!autoPaused && !hovering && !touching && !document.hidden) {
          setScenario(current + 1);
        }
      }, AUTOPLAY_MS);
    };
    const stopAuto = () => { if (autoTimer) { clearInterval(autoTimer); autoTimer = null; } };
    const pauseAuto = () => { autoPaused = true; };
    const resumeAuto = () => { autoPaused = false; };

    // Comparador táctil móvil
    btnRisk?.addEventListener('click', () => {
      forcedReveal = false;
      btnRisk.classList.add('active');
      btnRisk.setAttribute('aria-pressed', 'true');
      btnControl?.classList.remove('active');
      btnControl?.setAttribute('aria-pressed', 'false');
      hideReveal();
    });

    btnControl?.addEventListener('click', () => {
      pauseAuto();
      forcedReveal = true;
      btnControl.classList.add('active');
      btnControl.setAttribute('aria-pressed', 'true');
      btnRisk?.classList.remove('active');
      btnRisk?.setAttribute('aria-pressed', 'false');
      applyMask(0, 0);
      showReveal();
    });

    // Enlace de eventos en botones del carrusel unificado
    hero.addEventListener('mouseenter', onEnter);
    hero.addEventListener('mousemove', onMove, { passive: true });
    hero.addEventListener('mouseleave', onLeave);
    hero.addEventListener('touchstart', onTouchStart, { passive: true });
    hero.addEventListener('touchmove', onTouchMove, { passive: true });
    hero.addEventListener('touchend', onTouchEnd);

    tabs.forEach((t) => t.addEventListener('click', () => { pauseAuto(); setScenario(Number(t.dataset.index)); }));
    dots.forEach((d) => d.addEventListener('click', () => { pauseAuto(); setScenario(Number(d.dataset.index)); }));
    prevBtn?.addEventListener('click', () => { pauseAuto(); setScenario(current - 1); });
    nextBtn?.addEventListener('click', () => { pauseAuto(); setScenario(current + 1); });

    // Navegación accesible por teclado
    hero.setAttribute('tabindex', '0');
    hero.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') { pauseAuto(); setScenario(current - 1); }
      if (e.key === 'ArrowRight') { pauseAuto(); setScenario(current + 1); }
    });

    // Inicializar
    setScenario(0);
    rafId = requestAnimationFrame(loop);
    startAuto();

    // Limpieza al desmontar (eventos propios; GSAP se limpia dentro de su bloque)
    document.addEventListener('astro:before-swap', () => {
      stopAuto();
      cancelAnimationFrame(rafId);
      hero.removeEventListener('mouseenter', onEnter);
      hero.removeEventListener('mousemove', onMove);
      hero.removeEventListener('mouseleave', onLeave);
      hero.removeEventListener('touchstart', onTouchStart);
      hero.removeEventListener('touchmove', onTouchMove);
      hero.removeEventListener('touchend', onTouchEnd);
    });
  })();
</script>

<!-- ════════════════════════════════════════════════════════════════════
     ESTILOS CSS
     ════════════════════════════════════════════════════════════════════ -->
<style>
  /* ── Variables de Diseño ── */
  :root {
    --navy: #001A4D;
    --navy-deep: #001133;
    --yellow: #FFC800;
    --white: #F7F7F2;
    --font-serif: 'Playfair Display', Georgia, Cambria, serif;
    --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  *, *::before, *::after { box-sizing: border-box; }

  /* ════════════════════════════════════════
     ENCABEZADO / BARRA DE NAVEGACIÓN
     ════════════════════════════════════════ */
  .fosst-header {
    position: absolute; top: 0; left: 0; width: 100%; z-index: 50;
    padding: 0;
  }

  .header-backdrop {
    position: absolute; top: 0; left: 0; width: 100%;
    height: 105px;
    background: linear-gradient(
      180deg,
      rgba(0,17,51,.96) 0%,
      rgba(0,22,66,.85) 60%,
      rgba(0,17,51,0) 100%
    );
    pointer-events: none;
  }

  .header-container {
    position: relative; z-index: 1;
    max-width: 1400px; margin: 0 auto;
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    padding: 1.15rem 2rem;
  }

  .logo-link {
    display: flex; align-items: center; text-decoration: none;
    flex-shrink: 0; transition: opacity .2s;
  }
  .logo-link:hover { opacity: .92; }

  .fosst-logo-img {
    height: 40px; width: auto;
    object-fit: contain;
    filter: drop-shadow(0 2px 8px rgba(0,15,45,.4));
  }

  .nav-desktop { display: flex; align-items: center; }
  .nav-list { display: flex; align-items: center; gap: 2rem; list-style: none; margin: 0; padding: 0; }
  .nav-link {
    position: relative; display: inline-flex; align-items: center; gap: .35rem;
    font-family: var(--font-sans); font-size: .92rem; font-weight: 500;
    color: rgba(247,247,242,.88); text-decoration: none; padding: .5rem 0;
    transition: color .2s;
  }
  .nav-link:hover { color: var(--yellow); }
  .nav-link.active { color: #fff; font-weight: 600; }
  .active-indicator {
    position: absolute; bottom: -2px; left: 50%; transform: translateX(-50%);
    width: 22px; height: 3px; background: var(--yellow); border-radius: 99px;
    box-shadow: 0 0 8px var(--yellow);
  }
  .chevron-icon { transition: transform .2s; }
  .nav-link:hover .chevron-icon { transform: translateY(1.5px); }

  .header-actions { display: flex; align-items: center; gap: 1rem; flex-shrink: 0; }
  .search-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 38px; height: 38px; border-radius: 50%;
    background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.2);
    color: var(--white); cursor: pointer;
    transition: background .2s, border-color .2s;
  }
  .search-btn:hover { background: rgba(255,255,255,.18); border-color: rgba(255,255,255,.4); }

  .header-cta-btn {
    display: inline-flex; align-items: center; gap: .55rem;
    background: var(--yellow); color: var(--navy);
    font-family: var(--font-sans); font-size: .88rem; font-weight: 700;
    text-decoration: none; padding: .62rem 1.35rem; border-radius: 9999px;
    box-shadow: 0 4px 16px rgba(255,200,0,.35);
    transition: background .2s, transform .2s cubic-bezier(.16,1,.3,1), box-shadow .2s;
  }
  .header-cta-btn:hover { background: #ffd01a; transform: translateY(-1.5px) scale(1.02); box-shadow: 0 6px 22px rgba(255,200,0,.5); }
  .btn-arrow { transition: transform .2s; }
  .header-cta-btn:hover .btn-arrow, .btn:hover .btn-arrow { transform: translateX(3px); }

  .mobile-toggle {
    display: none; flex-direction: column; justify-content: space-around;
    width: 38px; height: 38px;
    background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.25);
    border-radius: 8px; padding: 8px; cursor: pointer; z-index: 60;
  }
  .hamburger-bar { width: 100%; height: 2px; background: var(--white); border-radius: 2px; transition: transform .25s, opacity .25s; }
  .mobile-toggle.is-open .hamburger-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .mobile-toggle.is-open .hamburger-bar:nth-child(2) { opacity: 0; }
  .mobile-toggle.is-open .hamburger-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .nav-mobile {
    display: none; position: absolute; top: 100%; left: 1rem; right: 1rem;
    background: rgba(0,26,77,.97); backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,.2); border-radius: 16px; padding: 1.5rem;
    box-shadow: 0 16px 48px rgba(0,10,30,.7);
    opacity: 0; pointer-events: none; transform: translateY(-10px);
    transition: opacity .25s, transform .25s;
  }
  .nav-mobile.is-open { display: block; opacity: 1; pointer-events: auto; transform: translateY(0); }
  .mobile-nav-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
  .mobile-nav-link {
    font-family: var(--font-sans); font-size: 1.05rem; font-weight: 600;
    color: var(--white); text-decoration: none; padding: .5rem 0; display: block;
    border-bottom: 1px solid rgba(255,255,255,.08);
  }
  .mobile-nav-link.active { color: var(--yellow); }
  .mobile-cta-item { margin-top: .75rem; list-style: none; }
  .mobile-cta-btn {
    display: flex; align-items: center; justify-content: center; gap: .5rem;
    width: 100%; background: var(--yellow); color: var(--navy);
    font-family: var(--font-sans); font-weight: 700; padding: .85rem;
    border-radius: 9999px; text-decoration: none; text-align: center;
  }

  /* ════════════════════════════════════════
     SCROLL TRACK & STAGE DEL HERO (TRANSICIÓN ESTILO LUPI)
     ════════════════════════════════════════ */
  .hero-scroll-track {
    position: relative;
    width: 100%;
    /* 240vh = 100vh sticky hero + 140vh scroll travel.
       La NarrativeTransition (margin-top: -100vh) empieza a solaparse
       al llegar a ~100vh de scroll, así el efecto de tarjeta que sube
       ocurre durante al menos 100vh de desplazamiento real. */
    height: 240vh;
    background: var(--navy-deep);
  }

  .hero-section {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: visible; /* Permite que la mascota sobresalga e integre el final del Hero con Nosotros */
    background: var(--navy-deep);
    z-index: 5;
  }

  /* ── Contenedor Visual del Carrusel que se Encoge con el Scroll ── */
  .hero-card-stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--navy-deep);
    /*
      Escala progresiva: 1 → 0.92.  Usa solo transform (GPU-composited).
      border-radius progresivo: 0 → 24px en las cuatro esquinas.
    */
    border-radius: clamp(0px, calc(var(--hero-progress, 0) * 24px), 24px);
    box-shadow: 0 24px 60px -12px rgba(0, 10, 30, calc(var(--hero-progress, 0) * 0.85));
    transform-origin: center center;
    transform: scale(calc(1 - var(--hero-progress, 0) * 0.08));
    will-change: transform, border-radius;
    transition: border-color 0.25s ease;
  }

  /* Capa de oscurecimiento progresivo sobre la tarjeta del hero */
  .hero-card-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 8, 24, 1);
    opacity: calc(var(--hero-progress, 0) * 0.45);
    pointer-events: none;
    z-index: 25;
    border-radius: inherit;
    will-change: opacity;
  }

  /* ── Capas de Fondo Full-Bleed ── */
  .hero-bg {
    position: absolute; inset: 0; z-index: 1;
    pointer-events: none; overflow: hidden;
  }
  .bg-base-layer {
    position: absolute; inset: 0; width: 100%; height: 100%;
    z-index: 1;
  }
  .bg-img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center;
    opacity: 0; transition: opacity .5s ease;
    pointer-events: none;
  }
  .bg-img.active { opacity: 1; }

  /* Degradado editorial: oscuro sobre el texto a la izquierda, 100% libre a la derecha */
  .hero-overlay {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background: linear-gradient(
      105deg,
      rgba(0,17,51,.90) 0%,
      rgba(0,26,77,.74) 28%,
      rgba(0,20,60,.35) 48%,
      rgba(0,15,45,.06) 68%,
      transparent 85%
    );
  }

  /* Capa de revelado interactivo (z: 4): sobre el overlay para mostrar la imagen nítida */
  .bg-reveal-layer {
    position: absolute; inset: 0; width: 100%; height: 100%;
    z-index: 4;
    opacity: 0; visibility: hidden;
    transition: opacity .3s cubic-bezier(.16,1,.3,1), visibility .3s;
    will-change: mask-image, -webkit-mask-image, opacity;
    -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
    pointer-events: none;
  }
  .bg-reveal-layer.is-active { opacity: 1; visibility: visible; }

  /* Difusión de borde orgánico cálido conectado al revelado */
  .reveal-glow-layer {
    position: absolute; inset: 0; z-index: 5;
    pointer-events: none;
    opacity: 0;
    transition: opacity .3s ease;
  }

  /* ════════════════════════════════════════
     PUNTOS DE INTERÉS Y LETREROS CONTEXTUALES (z: 6)
     Situados exactamente sobre el EPP / control correspondiente
     ════════════════════════════════════════ */
  .hotspots-layer {
    position: absolute; inset: 0; z-index: 15; pointer-events: none;
    opacity: calc(1 - var(--hero-progress, 0) * 3);
    will-change: opacity;
  }
  .hotspots-group { display: none; }
  .hotspots-group.active { display: block; }

  .hotspot-item {
    position: absolute;
    width: 36px; height: 36px;
    margin-left: -18px; margin-top: -18px;
    display: flex; align-items: center; justify-content: center;
    pointer-events: auto;
    z-index: 15;
    cursor: pointer;
  }

  /* Marcador discreto de color ámbar sobre el objeto */
  .hotspot-marker {
    display: block; width: 12px; height: 12px;
    border-radius: 50%; background: var(--yellow);
    box-shadow: 0 0 0 3px rgba(255,200,0,.3), 0 0 12px rgba(255,200,0,.65);
    transition: transform .25s ease, box-shadow .25s ease;
    animation: markerPulse 3s infinite ease-in-out;
    pointer-events: none;
  }
  @keyframes markerPulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(255,200,0,.3), 0 0 12px rgba(255,200,0,.65); }
    50% { box-shadow: 0 0 0 6px rgba(255,200,0,.12), 0 0 18px rgba(255,200,0,.4); }
  }

  /* Tarjeta contextual compacta: oculta por defecto, se revela únicamente sobre el punto exacto */
  .hotspot-card {
    position: absolute;
    display: flex; align-items: flex-start; gap: .65rem;
    background: rgba(0,17,51,.96); backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,.18);
    border-left: 3px solid var(--yellow);
    border-radius: 10px; padding: .65rem .85rem;
    box-shadow: 0 10px 32px rgba(0,10,30,.75);
    max-width: 235px; min-width: 195px;
    opacity: 0; visibility: hidden;
    pointer-events: none;
    transition: opacity .25s ease, transform .25s ease, visibility .25s;
    white-space: normal;
    z-index: 20;
  }

  /* Orientación hacia la derecha (hacia el espacio libre de la foto, lejos del texto) */
  .hotspot-card.pos-right {
    top: 50%; left: calc(100% + 14px);
    transform: translateY(-50%) translateX(-8px);
  }

  /* Orientación hacia la izquierda (para objetos en el borde derecho) */
  .hotspot-card.pos-left {
    top: 50%; right: calc(100% + 14px);
    transform: translateY(-50%) translateX(8px);
  }

  /* Orientación hacia arriba */
  .hotspot-card.pos-top {
    bottom: calc(100% + 14px); left: 50%;
    transform: translateX(-50%) translateY(8px);
  }

  /* Estado revelado por proximidad directa (cursor sobre el lugar específico) */
  .hotspot-item.is-revealed .hotspot-card,
  .hotspot-item:hover .hotspot-card {
    opacity: 1; visibility: visible;
    pointer-events: auto;
  }
  .hotspot-item.is-revealed .hotspot-card.pos-right,
  .hotspot-item:hover .hotspot-card.pos-right {
    transform: translateY(-50%) translateX(0);
  }
  .hotspot-item.is-revealed .hotspot-card.pos-left,
  .hotspot-item:hover .hotspot-card.pos-left {
    transform: translateY(-50%) translateX(0);
  }
  .hotspot-item.is-revealed .hotspot-card.pos-top,
  .hotspot-item:hover .hotspot-card.pos-top {
    transform: translateX(-50%) translateY(0);
  }
  .hotspot-item.is-revealed .hotspot-marker,
  .hotspot-item:hover .hotspot-marker {
    transform: scale(1.4);
    box-shadow: 0 0 0 5px rgba(255,200,0,.45), 0 0 18px rgba(255,200,0,.9);
  }

  .hotspot-icon { flex-shrink: 0; margin-top: 2px; }
  .hotspot-info { display: flex; flex-direction: column; gap: .2rem; }
  .hotspot-info strong {
    font-family: var(--font-sans); font-size: .82rem; font-weight: 700;
    color: var(--white); line-height: 1.25;
  }
  .hotspot-info span {
    font-family: var(--font-sans); font-size: .73rem; font-weight: 400;
    color: rgba(247,247,242,.84); line-height: 1.35;
  }

  /* ── Bloque Editorial de Texto (z: 10, completamente despejado) ── */
  .hero-content-wrap {
    position: relative; z-index: 10;
    width: 100%; max-width: 1400px;
    margin: 0 auto; padding: 7.5rem 2.5rem 7.5rem;
    pointer-events: none; /* Permite que el cursor pase directamente al hero para el efecto */
    transform: translateY(calc(var(--hero-progress, 0) * -40px));
    opacity: calc(1 - var(--hero-progress, 0) * 1.6);
    will-change: transform, opacity;
  }
  .hero-content {
    max-width: 560px; pointer-events: auto;
    animation: fadeUp .85s cubic-bezier(.16,1,.3,1) both;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-eyebrow { display: flex; align-items: center; gap: .85rem; margin-bottom: 1.25rem; }
  .eyebrow-line {
    width: 32px; height: 3px; background: var(--yellow);
    border-radius: 99px; box-shadow: 0 0 10px rgba(255,200,0,.5);
  }
  .eyebrow-text {
    font-family: var(--font-sans); font-size: .76rem; font-weight: 700;
    letter-spacing: .12em; color: rgba(247,247,242,.9); text-transform: uppercase;
  }

  .hero-headline {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 4.5vw, 3.8rem);
    font-weight: 700; line-height: 1.1;
    margin: 0 0 1.3rem; letter-spacing: -.02em;
    color: var(--white);
    text-shadow: 0 3px 18px rgba(0,15,45,.55);
  }
  .headline-accent {
    color: var(--yellow); font-style: italic; font-weight: 600;
    text-shadow: 0 2px 16px rgba(255,200,0,.3);
  }

  .hero-description {
    font-family: var(--font-sans);
    font-size: clamp(.95rem, 1.12vw, 1.06rem);
    line-height: 1.65; color: rgba(247,247,242,.9);
    margin: 0 0 2.25rem; max-width: 500px;
    text-shadow: 0 2px 8px rgba(0,15,45,.5);
  }

  .hero-actions {
    display: flex; align-items: center; gap: 1.1rem;
    flex-wrap: wrap; margin-bottom: 2.5rem;
  }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .6rem;
    font-family: var(--font-sans); font-size: .95rem;
    text-decoration: none; padding: .8rem 1.75rem; border-radius: 9999px;
    cursor: pointer; transition: transform .25s cubic-bezier(.16,1,.3,1), box-shadow .25s, background .25s, border-color .25s;
  }
  .btn-primary {
    background: var(--yellow); color: var(--navy); font-weight: 700;
    border: 2px solid var(--yellow);
    box-shadow: 0 6px 22px -4px rgba(255,200,0,.45);
  }
  .btn-primary:hover { background: #ffd01a; transform: translateY(-2px) scale(1.02); box-shadow: 0 10px 28px -2px rgba(255,200,0,.55); }
  .btn-secondary {
    background: rgba(255,255,255,.07); color: var(--white); font-weight: 600;
    border: 1.5px solid rgba(255,255,255,.35);
  }
  .btn-secondary:hover { background: rgba(255,255,255,.14); border-color: var(--yellow); color: var(--yellow); transform: translateY(-2px); }

  .hero-badges {
    display: flex; align-items: center; gap: 1.75rem; flex-wrap: wrap;
    padding-top: 1.2rem; border-top: 1px solid rgba(255,255,255,.1);
  }
  .badge-item { display: flex; align-items: center; gap: .6rem; }
  .badge-icon {
    display: flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 8px;
    background: rgba(255,200,0,.1); border: 1px solid rgba(255,200,0,.3);
    flex-shrink: 0;
  }
  .badge-label {
    font-family: var(--font-sans); font-size: .8rem; font-weight: 600;
    line-height: 1.2; color: rgba(247,247,242,.88);
  }

  /* ════════════════════════════════════════
     DOCK INFERIOR CENTRAL: CONTROLES DEL CARRUSEL AGRUPADOS (z: 20)
     ════════════════════════════════════════ */
  .hero-dock {
    position: absolute; bottom: 0; left: 0; width: 100%; z-index: 20;
    padding: 1rem 1.5rem 1.35rem;
    background: linear-gradient(to top, rgba(0,17,51,.88) 0%, rgba(0,17,51,.45) 60%, transparent 100%);
    pointer-events: none;
    display: flex; justify-content: center;
    transform: translateY(calc(var(--hero-progress, 0) * 28px));
    opacity: calc(1 - var(--hero-progress, 0) * 3);
    will-change: transform, opacity;
  }
  .dock-inner {
    max-width: 1400px; width: 100%;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .6rem;
    pointer-events: auto;
  }

  /* Cápsula unificada central del carrusel */
  .dock-carousel-bar {
    display: inline-flex; align-items: center; gap: .65rem;
    background: rgba(0, 20, 60, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 9999px;
    padding: .35rem .55rem;
    box-shadow: 0 10px 32px rgba(0, 10, 30, 0.6);
  }

  .dock-tabs {
    display: inline-flex; align-items: center; gap: .3rem;
  }
  .dock-tab {
    display: inline-flex; align-items: center; gap: .45rem;
    padding: .48rem .95rem; border-radius: 9999px;
    border: 1px solid transparent; background: transparent;
    color: rgba(247,247,242,.75); font-family: var(--font-sans);
    font-size: .82rem; font-weight: 600; cursor: pointer;
    transition: all .2s ease;
    white-space: nowrap;
  }
  .dock-tab:hover {
    background: rgba(255,255,255,.09); color: #fff;
  }
  .dock-tab.active {
    background: var(--navy); color: var(--yellow);
    border-color: rgba(255,200,0,.42);
    box-shadow: 0 2px 10px rgba(0, 15, 45, 0.5);
  }
  .dock-tab:focus-visible { outline: 2px solid var(--yellow); outline-offset: 2px; }

  .dock-divider {
    width: 1px; height: 20px;
    background: rgba(255, 255, 255, 0.18);
    margin: 0 .15rem;
  }

  .dock-dots {
    display: inline-flex; align-items: center; gap: .4rem;
    padding: 0 .2rem;
  }
  .dock-dot {
    width: 18px; height: 3.5px; border-radius: 99px; border: none;
    background: rgba(255,255,255,.25); cursor: pointer; padding: 0;
    transition: width .25s, background .25s;
  }
  .dock-dot:hover { background: rgba(255,255,255,.5); }
  .dock-dot.active { width: 32px; background: var(--yellow); box-shadow: 0 0 8px rgba(255,200,0,.6); }
  .dock-dot:focus-visible { outline: 2px solid var(--yellow); outline-offset: 2px; }

  .dock-arrow {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 50%;
    background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.18);
    color: var(--white); cursor: pointer;
    transition: background .2s, border-color .2s, color .2s, transform .2s;
    flex-shrink: 0;
  }
  .dock-arrow:hover {
    background: var(--yellow); border-color: var(--yellow); color: var(--navy);
    transform: scale(1.06);
  }
  .dock-arrow:focus-visible { outline: 2px solid var(--yellow); outline-offset: 2px; }

  /* Comparador táctil en móviles */
  .mobile-toggle-bar {
    display: none;
    background: rgba(0,20,60,.85); backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,.18); border-radius: 999px;
    padding: .2rem; gap: .2rem; pointer-events: auto;
    width: fit-content;
  }
  .cmp-btn {
    display: inline-flex; align-items: center; gap: .35rem;
    padding: .4rem .8rem; border-radius: 999px; border: none;
    background: transparent; color: rgba(247,247,242,.7);
    font-family: var(--font-sans); font-size: .76rem; font-weight: 600;
    cursor: pointer; transition: all .2s;
  }
  .cmp-btn.active { background: var(--yellow); color: var(--navy); font-weight: 700; }
  .cmp-dot { width: 6px; height: 6px; border-radius: 50%; }
  .cmp-dot.risk { background: #ff5252; }
  .cmp-dot.ok { background: #00e676; }

  /* Píldora guía */
  .guide-pill {
    position: absolute; bottom: 5.5rem; right: 2rem; z-index: 10;
    display: flex; align-items: center; gap: .5rem;
    background: rgba(0,18,55,.78); backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,.15); border-radius: 999px;
    padding: .4rem .9rem; color: var(--white);
    font-family: var(--font-sans); font-size: .74rem; font-weight: 600;
    box-shadow: 0 4px 14px rgba(0,10,30,.45);
    pointer-events: none;
    transition: opacity .3s, transform .3s;
    opacity: calc(1 - var(--hero-progress, 0) * 4);
    will-change: opacity;
  }
  .guide-pill.hidden { opacity: 0; transform: translateY(6px); }
  .guide-touch { display: none; }

  /* ════════════════════════════════════════
     MASCOTA OFICIAL FOSST (PUENTE VISUAL HERO → NOSOTROS)
     ════════════════════════════════════════ */
  .hero-mascot-bridge {
    position: absolute;
    bottom: -36px;
    right: clamp(1.5rem, 5.5vw, 5.5rem);
    /* z-index entre el hero-section (5) y la NarrativeTransition (20).
       La mascota surge sobre el hero pero queda por debajo de la tarjeta
       de NarrativeTransition cuando esta cubre el viewport. */
    z-index: 15;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform-origin: bottom center;
  }

  .mascot-figure {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: auto;
    /*
      Fase 1 (mascot-progress 0→1): la mascota sube con el scroll
      Fase 2 (hero-progress 0.6→1): se desvanece para no tapar el título
      de NarrativeTransition. La expresión CSS combina ambas fases:
        - translateY se anima por mascot-progress (entra desde abajo)
        - opacity combina mascot-progress (fade-in) × (1 - clamp de hero-progress) (fade-out)
    */
    transform: translateY(calc(120px * (1 - var(--mascot-progress, 0)))) scale(calc(0.85 + var(--mascot-progress, 0) * 0.15));
    opacity: calc(
      min(var(--mascot-progress, 0) * 1.4, 1) *
      clamp(0, (0.85 - var(--hero-progress, 0)) * 4, 1)
    );
    will-change: transform, opacity;
    transition: transform 0.08s linear, opacity 0.12s linear;
  }

  .mascot-img {
    width: clamp(210px, 18vw, 290px);
    height: auto;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 14px 28px rgba(0, 10, 30, 0.75)) drop-shadow(0 0 16px rgba(255, 200, 0, 0.2));
    animation: mascotGentleFloat 4.2s ease-in-out infinite alternate;
    transition: transform 0.3s cubic-bezier(.16,1,.3,1);
  }

  .mascot-figure:hover .mascot-img {
    transform: translateY(-4px) scale(1.03);
  }

  @keyframes mascotGentleFloat {
    0% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-5px) rotate(0.6deg); }
    100% { transform: translateY(-10px) rotate(-0.5deg); }
  }

  .mascot-ground-shadow {
    width: 70%;
    height: 12px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(0, 10, 30, 0.6) 0%, rgba(0, 10, 30, 0) 70%);
    margin-top: -6px;
    animation: mascotShadowPulse 4.2s ease-in-out infinite alternate;
  }

  @keyframes mascotShadowPulse {
    0% { transform: scale(1); opacity: 0.65; }
    50% { transform: scale(0.93); opacity: 0.5; }
    100% { transform: scale(0.85); opacity: 0.38; }
  }

  /* ════════════════════════════════════════
     RESPONSIVIDAD
     ════════════════════════════════════════ */
  @media (max-width: 1024px) {
    .hero-scroll-track { height: 220vh; }
    .nav-desktop, .header-cta-btn, .search-btn { display: none; }
    .mobile-toggle { display: flex; }
    .header-container { padding: 1rem 1.5rem; }
    .hero-content-wrap { padding: 6.5rem 1.5rem 7.5rem; }
    .hero-content { max-width: 100%; text-align: center; align-items: center; display: flex; flex-direction: column; }
    .hero-eyebrow { justify-content: center; }
    .hero-description { max-width: 600px; margin-left: auto; margin-right: auto; }
    .hero-actions { justify-content: center; }
    .hero-badges { justify-content: center; }
    .hotspots-layer { display: none; }
    .dock-carousel-bar { padding: .25rem .45rem; gap: .4rem; }
    .dock-tabs span { display: none; }
    .dock-tabs { gap: .2rem; }
    .dock-tab { padding: .45rem .6rem; }
    .dock-divider { display: none; }
    .mobile-toggle-bar { display: inline-flex; }
    .guide-desk { display: none; }
    .guide-touch { display: inline; }
    .guide-pill { right: 1rem; bottom: 7.5rem; }
    .hero-mascot-bridge {
      bottom: -28px;
      right: 1.5rem;
    }
    .mascot-img {
      width: clamp(160px, 24vw, 210px);
    }
    .hero-overlay {
      background: linear-gradient(
        180deg,
        rgba(0,17,51,.85) 0%,
        rgba(0,26,77,.55) 40%,
        rgba(0,26,77,.32) 70%,
        rgba(0,15,45,.6) 100%
      );
    }
  }

  @media (max-width: 640px) {
    .hero-scroll-track { height: 200vh; }
    .hero-card-stage {
      /* En móvil el border-radius máximo es más sutil */
      border-radius: clamp(0px, calc(var(--hero-progress, 0) * 18px), 18px);
    }
    .fosst-header { padding: 0; }
    .header-container { padding: .85rem 1rem; }
    .fosst-logo-img { height: 32px; }
    .hero-content-wrap { padding: 5.5rem 1rem 8.5rem; }
    .hero-headline { font-size: 2rem; }
    .hero-actions { flex-direction: column; width: 100%; gap: .75rem; }
    .btn { width: 100%; }
    .hero-badges { flex-direction: column; align-items: flex-start; width: 100%; gap: 1rem; }
    .badge-item { width: 100%; justify-content: flex-start; text-align: left; }
    .guide-pill { left: 1rem; right: 1rem; bottom: 9rem; justify-content: center; }
    .hero-mascot-bridge {
      bottom: -20px;
      right: 1rem;
    }
    .mascot-img {
      width: 145px;
    }
  }

  /* ── Accesibilidad ── */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: .01ms !important;
    }
    .hero-scroll-track { height: auto !important; }
    .hero-section { position: relative !important; height: auto !important; min-height: 100vh !important; }
    .hero-card-stage {
      position: relative !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      transform: none !important;
    }
    .hero-card-stage::after { display: none !important; }
    .hero-mascot-bridge { display: none !important; }
    .hero-content-wrap, .hero-dock, .guide-pill, .hotspots-layer {
      transform: none !important;
      opacity: 1 !important;
    }
    .bg-reveal-layer { display: none !important; }
    .reveal-glow-layer { display: none !important; }
  }
</style>
