---
// src/components/ServicesShowcase.astro
// Presentación visual y resumida de los 9 servicios oficiales de FOSST
// Diseño asimétrico con índice interactivo — Sin cuadrículas de tarjetas repetitivas
import { SERVICIOS } from '../data/servicios.js';

// Agrupación en los 3 ejes estratégicos de intervención
const clusters = [
  {
    axis: '01',
    name: 'Sistemas de Gestión & Cumplimiento Normativo',
    desc: 'Estructuración técnica para blindar legalmente a la empresa y responder ante el Ministerio del Trabajo.',
    slugs: ['sg-sst', 'auditorias-internas', 'asesoria-juridica-laboral']
  },
  {
    axis: '02',
    name: 'Factor Humano, Salud & Bienestar Integral',
    desc: 'Evaluación del clima y salud mental, gestión de perfiles y prevención de patologías ergonómicas.',
    slugs: ['riesgo-psicosocial', 'talento-humano', 'vigilancia-epidemiologica']
  },
  {
    axis: '03',
    name: 'Operaciones en Campo, Vía & Sostenibilidad',
    desc: 'Planes viales obligatorios, manejo de residuos peligrosos y brigadas de emergencia en terreno.',
    slugs: ['seguridad-vial-pesv', 'gestion-ambiental', 'formaciones-brigadas']
  }
];

const getService = (slug: string) => SERVICIOS.find((s) => s.slug === slug);
---

<section class="services-showcase-section" id="servicios" aria-labelledby="services-showcase-heading">
  <div class="services-container">
    
    <!-- Panel Izquierdo: Presentación Editorial Sticky -->
    <div class="services-intro-column">
      <div class="intro-sticky-content">
        <div class="section-eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          <span class="eyebrow-text">CATÁLOGO DE ESPECIALIDADES</span>
        </div>

        <h2 id="services-showcase-heading" class="services-heading">
          Soluciones integrales diseñadas para <em class="heading-accent">cada área</em> de tu empresa.
        </h2>

        <p class="services-lead">
          No ofrecemos plantillas genéricas. Cada una de nuestras 9 líneas de consultoría es ejecutada por profesionales con licencia en SST, psicólogos o auditores idóneos, con entregables medibles y trazables.
        </p>

        <div class="services-cta-box">
          <a href="/servicios" class="btn-all-services">
            <span>Ver catálogo completo y alcances</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <span class="services-note">
            ¿No sabes cuál necesita tu empresa? <a href="/diagnostico" class="inline-diag-link">Realiza el diagnóstico gratuito</a>
          </span>
        </div>
      </div>
    </div>

    <!-- Panel Derecho: Directorio de los 3 Ejes Estratégicos -->
    <div class="services-list-column">
      {clusters.map((cluster) => (
        <div class="cluster-block">
          <header class="cluster-header">
            <span class="cluster-number" aria-hidden="true">{cluster.axis}</span>
            <div class="cluster-titles">
              <h3 class="cluster-name">{cluster.name}</h3>
              <p class="cluster-desc">{cluster.desc}</p>
            </div>
          </header>

          <div class="cluster-items">
            {cluster.slugs.map((slug) => {
              const item = getService(slug);
              if (!item) return null;
              return (
                <a href={`/servicios/${item.slug}`} class="service-row-item" aria-label={`Ver detalles de ${item.nombre}`}>
                  <div class="item-main">
                    <div class="item-title-row">
                      <span class="item-name">{item.nombre}</span>
                      <span class="item-pill">
                        {item.slug === 'sg-sst' && 'Res. 0312/19'}
                        {item.slug === 'riesgo-psicosocial' && 'Res. 2764/22'}
                        {item.slug === 'seguridad-vial-pesv' && 'Res. 40595/22'}
                        {item.slug === 'auditorias-internas' && 'ISO 45001 / 9001'}
                        {item.slug === 'asesoria-juridica-laboral' && 'Legal Preventiva'}
                        {item.slug === 'talento-humano' && 'Perfiles & Clima'}
                        {item.slug === 'gestion-ambiental' && 'PGIRS & RESPEL'}
                        {item.slug === 'vigilancia-epidemiologica' && 'Ergonomía & ARL'}
                        {item.slug === 'formaciones-brigadas' && 'Entrenamiento 5S'}
                      </span>
                    </div>
                    <p class="item-summary">{item.descripcionCorta}</p>
                  </div>

                  <div class="item-action" aria-hidden="true">
                    <span class="action-text">Detalles</span>
                    <svg class="action-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .services-showcase-section {
    position: relative;
    background-color: #000F2E;
    color: #F7F7F2;
    padding: 7rem 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .services-container {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }
  @media (min-width: 960px) {
    .services-container {
      grid-template-columns: 1fr 1.45fr;
      gap: 4.5rem;
    }
  }

  /* Columna Izquierda Sticky */
  .services-intro-column {
    position: relative;
  }
  @media (min-width: 960px) {
    .intro-sticky-content {
      position: sticky;
      top: 6rem;
    }
  }

  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
  }
  .eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--yellow, #FFC800);
    box-shadow: 0 0 10px rgba(255, 200, 0, 0.7);
  }
  .eyebrow-text {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--yellow, #FFC800);
    text-transform: uppercase;
  }

  .services-heading {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: clamp(2.1rem, 3.5vw, 3rem);
    font-weight: 700;
    line-height: 1.2;
    color: #FFFFFF;
    margin: 0 0 1.5rem;
    letter-spacing: -0.015em;
  }
  .heading-accent {
    color: var(--yellow, #FFC800);
    font-style: italic;
    font-weight: 600;
  }

  .services-lead {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 1rem;
    line-height: 1.68;
    color: rgba(247, 247, 242, 0.82);
    margin: 0 0 2.25rem;
  }

  .services-cta-box {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .btn-all-services {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    background: var(--yellow, #FFC800);
    color: #001A4D;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    padding: 0.85rem 1.6rem;
    border-radius: 9999px;
    box-shadow: 0 6px 20px -3px rgba(255, 200, 0, 0.4);
    transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
    width: fit-content;
  }
  .btn-all-services:hover {
    background: #ffd01a;
    transform: translateY(-2px);
    box-shadow: 0 10px 24px -2px rgba(255, 200, 0, 0.55);
  }

  .services-note {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.82rem;
    color: rgba(247, 247, 242, 0.6);
  }
  .inline-diag-link {
    color: var(--yellow, #FFC800);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .inline-diag-link:hover {
    color: #FFFFFF;
  }

  /* Columna Derecha: Bloques de Ejes */
  .services-list-column {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .cluster-block {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .cluster-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .cluster-number {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--yellow, #FFC800);
    opacity: 0.85;
  }

  .cluster-titles {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cluster-name {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0;
  }

  .cluster-desc {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.82rem;
    line-height: 1.45;
    color: rgba(247, 247, 242, 0.65);
    margin: 0;
  }

  /* Filas interactivas de servicio */
  .cluster-items {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .service-row-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 1.4rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }

  .service-row-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3.5px;
    background: var(--yellow, #FFC800);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .service-row-item:hover {
    background: rgba(0, 26, 77, 0.55);
    border-color: rgba(255, 200, 0, 0.35);
    transform: translateX(4px);
  }
  .service-row-item:hover::before {
    opacity: 1;
  }

  .item-main {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .item-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .item-name {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 1.02rem;
    font-weight: 700;
    color: #FFFFFF;
    transition: color 0.2s ease;
  }
  .service-row-item:hover .item-name {
    color: var(--yellow, #FFC800);
  }

  .item-pill {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.55rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(247, 247, 242, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .item-summary {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.84rem;
    line-height: 1.45;
    color: rgba(247, 247, 242, 0.7);
    margin: 0;
  }

  .item-action {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: rgba(247, 247, 242, 0.6);
    flex-shrink: 0;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .action-text {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .service-row-item:hover .item-action {
    color: var(--yellow, #FFC800);
  }
  .service-row-item:hover .action-arrow {
    transform: translateX(4px);
  }
</style>
